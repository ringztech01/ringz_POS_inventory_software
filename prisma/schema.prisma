generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// LEGACY — the old fixed role on User.role, kept until the follow-up
// migration (after Role / User.roleId is confirmed). Renamed from `Role` so
// the Role model below can take that name; MySQL stores enums inline, so the
// rename changes no SQL.
enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum TaxType {
  EXCLUSIVE
  INCLUSIVE
}

enum AdjustmentItemType {
  ADDITION
  SUBTRACTION
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Sale returns have their own lifecycle (from the design). Stock comes back
// into the warehouse only while RECEIVED or COMPLETED; PENDING moves none.
enum SaleReturnStatus {
  PENDING
  RECEIVED
  COMPLETED
}

// In-transit rule: a transfer moves stock (From → To) only while COMPLETED.
// PENDING and SENT are paperwork only — nothing leaves From until Completed.
enum TransferStatus {
  PENDING
  SENT
  COMPLETED
}

// Restaurant module. STANDARD: a retail product. MENU_ITEM: sold on orders.
// INGREDIENT: stock used by menu items' recipes.
enum ProductType {
  STANDARD
  MENU_ITEM
  INGREDIENT
}

// Where a menu item is made (the kitchen display's station filter).
enum PrepStation {
  KITCHEN
  BAR
}

// A line's course on the touch POS (Part 6e): sent together, or held and
// fired later.
enum OrderCourse {
  STARTER
  MAIN
  DESSERT
}

// The touch POS's two sides (Part 6e): its toggle, colours and groups.
enum MenuDepartment {
  FOOD
  BAR
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  // A tab at the bar (touch POS): a name instead of a table.
  BAR_TAB
}

// An order's discount: a % of the bill's sub total, or a Naira amount.
enum OrderDiscountType {
  PERCENT
  AMOUNT
}

// How a bill was split: N equal parts, by the items each guest had, or by
// amounts the guests chose.
enum BillSplitMode {
  EQUAL
  ITEMS
  AMOUNT
}

// A bill part: OPEN until it's paid (settled on its own).
enum BillPartStatus {
  OPEN
  PAID
}

// OPEN -> SENT (lines in the kitchen) -> SERVED -> BILLED (its Sale exists).
// CANCELLED: voided before billing. OPEN, SENT and SERVED hold the table:
// one such order per table (Order.activeTableId).
enum OrderStatus {
  OPEN
  SENT
  SERVED
  BILLED
  CANCELLED
}

// One order line's progress. NEW: on the order, not sent yet. PENDING: sent,
// waiting in the kitchen ("Sent" on the order screen, "Pending" on the
// kitchen display). Then PREPARING, READY, SERVED.
enum KitchenStatus {
  NEW
  PENDING
  PREPARING
  READY
  SERVED
}

// A kitchen order ticket: NEW lines sent to a station, or a VOID for a sent
// line that was cancelled.
enum KotType {
  NEW
  VOID
}

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
}

// Why food or stock was thrown away (WasteEntry.reason). OTHER needs a note.
enum WasteReason {
  BURNT
  EXPIRED
  DROPPED
  RETURNED_BY_GUEST
  OVERPRODUCTION
  OTHER
}

// ACTIVE: the waste's stock is out. VOID: an entry that was voided, or the
// VOID entry that reversed it (voidOfId) — the same pattern as KOTs.
enum WasteStatus {
  ACTIVE
  VOID
}

// Business-wide settings: a single row, id "default". Read through
// lib/business-settings.ts, which falls back to these defaults until the row
// is first saved (from the Settings page).
model BusinessSetting {
  id                              String              @id @default("default")
  // The optional Restaurant module (modules/restaurant). Off: its routes
  // 404 and its sidebar group and Role-form permissions are hidden.
  restaurantEnabled               Boolean             @default(false)
  // Restaurant rules. A Booked reservation shows its table as Reserved this
  // many minutes before its time.
  restaurantReservedWindowMinutes Int                 @default(60)
  // Bookings on one table must be at least this many minutes apart.
  restaurantBookingGapMinutes     Int                 @default(120)
  // true: a billed table shows Cleaning until it's marked clean; false: it's
  // Available as soon as the bill is paid.
  restaurantManualCleaning        Boolean             @default(true)
  // Added to every restaurant bill: this % of the items before tax.
  restaurantServiceChargePercent  Decimal             @default(10) @db.Decimal(5, 2)
  // A discount above this % of the bill's sub total needs a PIN from someone
  // with Approve Discount.
  restaurantDiscountLimitPercent  Decimal             @default(10) @db.Decimal(5, 2)
  // Waste is taken out of this warehouse (an order line's waste: its order's
  // warehouse). Filled by the add_waste migration with the dining areas'.
  restaurantWarehouseId           String?
  // Waste costing more than this (₦) needs a PIN from someone with Approve
  // Waste; 0: no approval needed.
  restaurantWasteApprovalLimit    Decimal             @default(0) @db.Decimal(12, 2)
  // The dashboard's Waste today KPI turns amber / red above these % of
  // today's food cost.
  restaurantWasteAmberPercent     Decimal             @default(5) @db.Decimal(5, 2)
  restaurantWasteRedPercent       Decimal             @default(10) @db.Decimal(5, 2)
  // Touch POS: after a dish is added, back to the department's home (on) or
  // stay on the grid it came from (off).
  restaurantPosReturnHome         Boolean             @default(false)
  // Touch POS Note keypad: the quick notes, in order (a JSON list of
  // strings); none: the default list (lib/quickNotes).
  restaurantQuickNotes            Json?
  // Touch POS: after Send, back to the floor plan (on) or stay on the order.
  restaurantPosSendToFloor        Boolean             @default(true)
  // Touch POS: lock the screen (PIN to carry on) after this many seconds
  // without a tap; 0 never.
  restaurantPosLockSeconds        Int                 @default(0)
  // The same for Managers and the Administrator (back-office roles, Part 6f
  // Step 6); used only while auto-lock is on (restaurantPosLockSeconds > 0).
  restaurantPosLockSecondsManager Int                 @default(300)
  // Touch POS: the light theme (on) or the dark frame (off), on every till.
  restaurantPosLightTheme         Boolean             @default(false)
  // Which restaurant screens the app uses (Part 6f): SERVICE — PIN login,
  // the touch Tables screen and Restaurant POS; CLASSIC — Restaurant ›
  // Floor, the Table order page, and the retail POS on /pos. A device can
  // override it (Device.restaurantInterface).
  restaurantInterface             RestaurantInterface @default(SERVICE)
  // Staff PINs (Part 6f; Settings › Staff, Administrator only): allow weak
  // ones (1234, 0000…); let staff change their own (with the old one).
  restaurantAllowWeakPins         Boolean             @default(false)
  restaurantStaffSelfPin          Boolean             @default(false)
  // The PIN screen without the on-shift names (type your PIN only).
  restaurantPinHideNames          Boolean             @default(false)
  // Clock in / out (Part 6f Step 6, Settings › Staff): "Start shift?" after a
  // PIN sign-in, "End shift?" at LOCK; the PIN screen lists who's on shift.
  restaurantClockInOut            Boolean             @default(false)
  // Restaurant Reports: the business day starts this many minutes after
  // midnight (Africa/Lagos) — 240: an order closed at 01:30 counts on the
  // day before. 0–360, in steps of 30 (Settings › Touch POS).
  restaurantDayStartMinutes       Int                 @default(0)
  // Restaurant Reports › Shifts & cash-up: a cash-up whose variance (over or
  // short) is more than this shows red (Settings › Touch POS).
  restaurantCashVarianceLimit     Decimal             @default(500) @db.Decimal(12, 2)
  // Emergency access (Part 6f Step 4): one recovery code at a time — its
  // bcrypt hash; used once by an Administrator on a device that isn't a
  // terminal. Made in Settings › Staff.
  recoveryCodeHash                String?             @db.VarChar(100)
  recoveryCodeAt                  DateTime?
  // ---- Printed tickets (Settings › Ticket templates; lib/hardware/tickets.ts)
  // The logo on receipts and pre-bills: on/off, and the image itself, turned
  // to 1-bit once (at most 384 × 240 dots) — rows of ceil(width / 8) bytes.
  printLogo                       Boolean             @default(false)
  printLogoWidth                  Int?
  printLogoHeight                 Int?
  printLogoData                   Bytes?              @db.MediumBlob
  // The business header and the footer, line by line (null: the defaults).
  printHeader                     String?             @db.Text
  printFooter                     String?             @db.Text
  // KOT lines in large type; prices on KOT lines (default off).
  printKitchenLarge               Boolean             @default(false)
  printKotPrices                  Boolean             @default(false)
  // A QR code under receipts and pre-bills, holding this (a link, Wi-Fi…).
  printQr                         Boolean             @default(false)
  printQrText                     String?             @db.VarChar(300)
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt

  restaurantWarehouse Warehouse?          @relation("RestaurantWarehouse", fields: [restaurantWarehouseId], references: [id])
  wasteEntries        WasteEntry[]
  printers            Printer[]
  printerAssignments  PrinterAssignment[]
  printJobs           PrintJob[]
  drawerEvents        DrawerEvent[]
  auditLogs           AuditLog[]
  menuSettings        MenuSettings?
  qrPoints            QrPoint[]
}

model User {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  email          String    @unique
  password       String
  phoneNumber    String?
  image          String?
  // LEGACY (see UserRole) — replaced by roleId; dropped in a follow-up
  // migration once every user's mapping is confirmed.
  role           UserRole  @default(CASHIER)
  // Nullable until that follow-up migration makes it required.
  roleId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  // ---- Staff (Part 6f). The name on tickets ("Ada O."); their colour on the
  // POS; where their Tables screen opens / the station their kitchen display
  // shows (else the role's).
  displayName    String?   @db.VarChar(40)
  colour         String?   @db.VarChar(7)
  homeAreaId     String?
  homeStation    String?   @db.VarChar(20)
  // Disabled: can't sign in, history kept (instead of deleting).
  disabledAt     DateTime?
  lastLoginAt    DateTime?
  // The device (Device.id) they last signed in on.
  lastDeviceId   String?   @db.VarChar(64)
  // +1 ends every session they have, on every device (a PIN reset, disabling).
  sessionVersion Int       @default(0)
  // Added in Settings › Staff: signs in by PIN only (the email and password
  // are placeholders nobody knows).
  pinOnly        Boolean   @default(false)
  // A staff card or badge (Part 6f Step 7d): RFID/NFC or a barcode, read by
  // the scanner — signs in like the PIN. Kept as a keyed hash only (one
  // person per card); cardLabel is its last characters, to tell cards apart.
  cardHash       String?   @unique @db.VarChar(64)
  cardLabel      String?   @db.VarChar(12)
  cardSetAt      DateTime?
  // Training mode (Part 6f Step 7f; Settings › Staff): their orders are
  // TRAINING ones — the real floor, but nothing printed to or shown in the
  // kitchen, no stock moved, no sale when settled.
  trainingMode   Boolean   @default(false)

  userRole           Role?               @relation(fields: [roleId], references: [id])
  homeArea           DiningArea?         @relation("StaffHomeArea", fields: [homeAreaId], references: [id], onDelete: SetNull)
  adjustments        Adjustment[]
  purchases          Purchase[]
  purchaseReturns    PurchaseReturn[]
  sales              Sale[]
  salePayments       SalePayment[]
  saleReturns        SaleReturn[]
  saleReturnPayments SaleReturnPayment[]
  transfers          Transfer[]
  expenses           Expense[]
  // Restaurant module.
  waitedOrders       Order[]             @relation("OrderWaiter")
  cancelledLines     OrderItem[]         @relation("OrderItemCancelledBy")
  reservations       Reservation[]
  floorLayouts       FloorLayout[]       @relation("FloorLayoutCreatedBy")
  kots               Kot[]
  discountedOrders   Order[]             @relation("OrderDiscountBy")
  approvedDiscounts  Order[]             @relation("OrderDiscountApprovedBy")
  approvalPin        ApprovalPin?
  settlements        OrderSettlement[]
  tips               OrderTip[]          @relation("OrderTipWaiter")
  ackedRequests      TableRequest[]      @relation("TableRequestAck")
  decidedGuestLines  GuestOrderLine[]    @relation("GuestLineDecidedBy")
  orderRefunds       OrderRefund[]
  wasteLogged        WasteEntry[]        @relation("WasteLoggedBy")
  printJobs          PrintJob[]
  wasteApproved      WasteEntry[]        @relation("WasteApprovedBy")
  drawerEvents       DrawerEvent[]
  auditLogs          AuditLog[]
  shifts             StaffShift[]
  tillsOpened        TillSession[]       @relation("TillOpenedBy")
  tillsClosed        TillSession[]       @relation("TillClosedBy")

  @@index([deletedAt])
  @@index([roleId])
}

// A named set of permissions (Roles & Permissions). The seeded admin role is
// isSystem: it implicitly has every permission and can't be deleted.
model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  isSystem    Boolean     @default(false)
  // ---- Staff roles (Part 6f). The six built-in ones (Administrator,
  // Manager, Cashier, Waiter, Bartender, Kitchen) carry their key and can't
  // be deleted; a custom role (often a copy of one) has none.
  systemRole  SystemRole? @unique
  // SERVICE: the service screens only. BACK_OFFICE: the back office too
  // (dashboard, settings, inventory, reports). Only an Administrator grants it.
  accessLevel AccessLevel @default(SERVICE)
  // Where someone with the role lands after their PIN, and (optionally) the
  // area the Tables screen opens on / the station the kitchen display shows.
  homeScreen  HomeScreen  @default(TABLES)
  homeAreaId  String?
  homeStation String?     @db.VarChar(20)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  homeArea    DiningArea?      @relation(fields: [homeAreaId], references: [id], onDelete: SetNull)
  permissions RolePermission[]
  users       User[]

  @@index([deletedAt])
}

// One granted permission. `permission` is one of the strings in
// lib/permissions.ts (PERMISSIONS) — validated there, stored as text so the
// list can grow without a migration.
model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  zipCode     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  stocks          ProductStock[]
  adjustments     Adjustment[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  sales           Sale[]
  saleReturns     SaleReturn[]
  transfersOut    Transfer[]        @relation("TransferFrom")
  transfersIn     Transfer[]        @relation("TransferTo")
  expenses        Expense[]
  // Restaurant module.
  diningAreas     DiningArea[]
  orders          Order[]
  wasteEntries    WasteEntry[]
  // The restaurant's warehouse (BusinessSetting.restaurantWarehouseId).
  restaurantFor   BusinessSetting[] @relation("RestaurantWarehouse")

  @@index([deletedAt])
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  address     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  stocks          ProductStock[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@index([deletedAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([deletedAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([deletedAt])
}

model Unit {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([deletedAt])
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  code               String        @unique
  price              Decimal       @db.Decimal(12, 2)
  // Default net unit cost for purchase lines; not yet on the Product form.
  cost               Decimal?      @db.Decimal(12, 2)
  categoryId         String
  brandId            String
  unitId             String
  stockAlert         Int?
  orderTax           Decimal?      @db.Decimal(5, 2)
  taxType            TaxType
  quantityLimitation Int?
  notes              String?       @db.Text
  // Array of uploaded image paths; the first entry is the list thumbnail.
  // MySQL has no native array column, so this is stored as JSON.
  images             Json?
  // Restaurant module. Every existing product is STANDARD (retail); the
  // other columns only mean something for MENU_ITEM.
  productType        ProductType   @default(STANDARD)
  // Listed on the digital menu.
  showOnMenu         Boolean       @default(false)
  // Can be ordered right now (off: "Unavailable" on the menu and order screen).
  isAvailable        Boolean       @default(true)
  // Superseded by stationId (kept so nothing existing changes).
  prepStation        PrepStation?
  // Where it's made (the kitchen display's station). None: the first active
  // station.
  stationId          String?
  // Digital menu (Part 8): the card's short description (300 at most), its
  // media and what the guest is told about it.
  menuDescription    String?       @db.VarChar(300)
  // The photo (uploads/menu/<productId>/…, WebP); was menuImage.
  photoPath          String?
  // 360° spin: the frames' paths in order — none, or 24–36.
  spinFrames         Json?
  // 3D: GLB for the browser and Android AR, USDZ for iPhone AR.
  modelGlbPath       String?
  modelUsdzPath      String?
  // Which media the menu shows.
  mediaType          MenuMediaType @default(PHOTO)
  // Allergen names, as a JSON array of strings.
  allergens          Json?
  calories           Int?
  isSignature        Boolean       @default(false)
  // Touch POS: the group its button sits in, and its cell in that group's
  // grid (0-based across pages of 30; none: the next free cell).
  menuGroupId        String?
  menuGridPosition   Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  category            Category              @relation(fields: [categoryId], references: [id])
  brand               Brand                 @relation(fields: [brandId], references: [id])
  unit                Unit                  @relation(fields: [unitId], references: [id])
  stocks              ProductStock[]
  adjustmentItems     AdjustmentItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  transferItems       TransferItem[]
  // Restaurant module.
  orderItems          OrderItem[]
  guestOrderLines     GuestOrderLine[]
  modifierGroups      ModifierGroup[]
  recipeLines         RecipeLine[]          @relation("RecipeMenuItem")
  usedInRecipes       RecipeLine[]          @relation("RecipeIngredient")
  wasteEntries        WasteEntry[]
  wasteLines          WasteEntryLine[]
  availabilityLog     MenuAvailabilityLog[]
  kitchenStation      KitchenStation?       @relation(fields: [stationId], references: [id], onDelete: SetNull)
  menuGroup           MenuGroup?            @relation(fields: [menuGroupId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([productType])
  @@index([stationId])
  @@index([menuGroupId])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
}

// The current stock balance for one product in one warehouse — exactly one
// row per (productId, warehouseId) pair, never a movement ledger. Every
// change (initial stock on product create, Adjustments, eventually
// Purchases/Sales/Transfers) goes through lib/stock.ts's increase/decrease
// helpers, which upsert this row inside a transaction. "In stock" for a
// product is the sum of its rows across warehouses (groupBy/_sum), and the
// per-warehouse breakdown is just these rows directly.
model ProductStock {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  supplierId  String?
  quantity    Int
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@index([supplierId])
}

model Adjustment {
  id          String    @id @default(cuid())
  reference   String    @unique
  warehouseId String
  date        DateTime
  notes       String?   @db.Text
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     AdjustmentItem[]

  @@index([deletedAt])
  @@index([warehouseId])
}

model AdjustmentItem {
  id           String             @id @default(cuid())
  adjustmentId String
  productId    String
  quantity     Int
  type         AdjustmentItemType

  adjustment Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
}

model Purchase {
  id             String         @id @default(cuid())
  reference      String         @unique
  supplierId     String
  warehouseId    String
  date           DateTime
  status         PurchaseStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  shipping       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  paymentType    PaymentType    @default(CASH)
  paymentStatus  PaymentStatus  @default(UNPAID)
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]
  returns   PurchaseReturn[]

  @@index([deletedAt])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([date])
}

model PurchaseItem {
  id           String       @id @default(cuid())
  purchaseId   String
  productId    String
  quantity     Int
  purchaseUnit String
  // Unit cost as entered; subtotal and amounts are recomputed server-side
  // through lib/pricing.ts and stored for display/reporting.
  netUnitCost  Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// A return of purchased goods to the supplier — the outbound mirror of
// Purchase. While RECEIVED it takes stock OUT of its warehouse (a Purchase
// puts stock in); see lib/purchase-stock.ts for the reconciliation.
model PurchaseReturn {
  id             String         @id @default(cuid())
  reference      String         @unique
  supplierId     String
  warehouseId    String
  // Optional link to the purchase being returned against.
  purchaseId     String?
  date           DateTime
  status         PurchaseStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  shipping       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  paid           Decimal        @default(0) @db.Decimal(12, 2)
  due            Decimal        @db.Decimal(12, 2)
  paymentType    PaymentType    @default(CASH)
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  purchase  Purchase?            @relation(fields: [purchaseId], references: [id])
  createdBy User                 @relation(fields: [createdById], references: [id])
  items     PurchaseReturnItem[]

  @@index([deletedAt])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([purchaseId])
  @@index([date])
}

model PurchaseReturnItem {
  id           String       @id @default(cuid())
  returnId     String
  productId    String
  quantity     Int
  purchaseUnit String
  // Unit cost as entered; subtotal and amounts are recomputed server-side
  // through lib/pricing.ts, exactly as for PurchaseItem.
  netUnitCost  Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  // Named purchaseReturn (not "return") to keep the client field readable.
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

// A sale to a customer. While RECEIVED it takes stock OUT of its warehouse
// (same status rule and reconciliation as Purchases, direction "out").
//
// paid / due / paymentStatus / paymentType are derived from the sale's
// active SalePayment rows vs grandTotal (computePaymentState) and stored only
// so the list can show and sum them — they are never typed in directly.
model Sale {
  id             String         @id @default(cuid())
  reference      String         @unique
  customerId     String
  warehouseId    String
  date           DateTime
  status         PurchaseStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  shipping       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  paid           Decimal        @default(0) @db.Decimal(12, 2)
  due            Decimal        @db.Decimal(12, 2)
  paymentStatus  PaymentStatus  @default(UNPAID)
  // Type of the latest active payment (list column); null until paid.
  paymentType    PaymentType?
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  customer              Customer          @relation(fields: [customerId], references: [id])
  warehouse             Warehouse         @relation(fields: [warehouseId], references: [id])
  createdBy             User              @relation(fields: [createdById], references: [id])
  items                 SaleItem[]
  payments              SalePayment[]
  returns               SaleReturn[]
  // Restaurant module: the order this sale billed, if any, and each time
  // part of its bill was paid.
  order                 Order?
  restaurantSettlements OrderSettlement[]

  @@index([deletedAt])
  @@index([customerId])
  @@index([warehouseId])
  @@index([date])
}

model SaleItem {
  id           String       @id @default(cuid())
  saleId       String
  productId    String
  quantity     Int
  saleUnit     String
  // Unit price as entered (defaults to Product.price); subtotal and amounts
  // are recomputed server-side through lib/pricing.ts.
  netUnitPrice Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnLines SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

// One payment against a sale; a sale can have several. Soft-deleted rows
// don't count towards paid.
model SalePayment {
  id          String      @id @default(cuid())
  saleId      String
  amount      Decimal     @db.Decimal(12, 2)
  paymentType PaymentType
  date        DateTime
  notes       String?     @db.Text
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  // The till it was taken on, while that till was open (Part 6f Step 7b,
  // cash-up); null: anywhere else (the Sales form, a till not opened).
  tillSessionId String?

  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
  till      TillSession? @relation(fields: [tillSessionId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([deletedAt])
  @@index([tillSessionId])
}

// A customer returning goods from a sale. Always created from a sale: the
// customer and warehouse are copied from it and never chosen on the form.
// While RECEIVED or COMPLETED it puts stock back INTO the warehouse (the
// reverse of a sale).
//
// paid / due / paymentStatus describe the REFUND owed to the customer —
// derived from the active SaleReturnPayment rows vs grandTotal with
// computePaymentState, never typed in.
model SaleReturn {
  id             String           @id @default(cuid())
  reference      String           @unique
  // Required for every new return; nullable at the DB level per spec.
  saleId         String?
  customerId     String
  warehouseId    String
  date           DateTime
  status         SaleReturnStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal          @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal          @default(0) @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  shipping       Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal          @db.Decimal(12, 2)
  paid           Decimal          @default(0) @db.Decimal(12, 2)
  due            Decimal          @db.Decimal(12, 2)
  paymentStatus  PaymentStatus    @default(UNPAID)
  notes          String?          @db.Text
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  sale             Sale?               @relation(fields: [saleId], references: [id])
  customer         Customer            @relation(fields: [customerId], references: [id])
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy        User                @relation(fields: [createdById], references: [id])
  items            SaleReturnItem[]
  payments         SaleReturnPayment[]
  // Restaurant module: the refund of a settled bill this return records.
  restaurantRefund OrderRefund?

  @@index([deletedAt])
  @@index([saleId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([date])
  // Restaurant Reports (Step 11)
  @@index([createdAt])
}

model SaleReturnItem {
  id           String       @id @default(cuid())
  returnId     String
  productId    String
  // The original sale line being returned. RESTRICT: a sale line with return
  // history is never deleted (Sales edit updates lines in place).
  saleItemId   String
  quantity     Int
  saleUnit     String
  // Unit price as on the sale line (or edited in the line modal); amounts are
  // recomputed server-side through lib/pricing.ts.
  netUnitPrice Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([saleItemId])
}

// One refund paid to the customer against a sale return (same pattern as
// SalePayment). Soft-deleted rows don't count towards paid.
model SaleReturnPayment {
  id           String      @id @default(cuid())
  saleReturnId String
  amount       Decimal     @db.Decimal(12, 2)
  paymentType  PaymentType
  date         DateTime
  notes        String?     @db.Text
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  // The till it was paid out of, while open (Part 6f Step 7b).
  tillSessionId String?

  saleReturn SaleReturn   @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  createdBy  User         @relation(fields: [createdById], references: [id])
  till       TillSession? @relation(fields: [tillSessionId], references: [id], onDelete: SetNull)

  @@index([saleReturnId])
  @@index([deletedAt])
  @@index([tillSessionId])
}

// Moves stock between two warehouses. No supplier, customer or payment.
// Money columns mirror the other documents (valued at cost).
model Transfer {
  id              String         @id @default(cuid())
  reference       String         @unique
  fromWarehouseId String
  toWarehouseId   String
  date            DateTime
  status          TransferStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax        Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount  Decimal        @default(0) @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  shipping        Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal        @db.Decimal(12, 2)
  notes           String?        @db.Text
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  fromWarehouse Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  items         TransferItem[]

  @@index([deletedAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([date])
}

model TransferItem {
  id           String       @id @default(cuid())
  transferId   String
  productId    String
  quantity     Int
  transferUnit String
  // Unit cost as entered (defaults to Product.cost); subtotal and amounts
  // are recomputed server-side through lib/pricing.ts.
  netUnitCost  Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

// Name-only lookup for expenses (managed like Product Categories / Brands,
// but without a logo).
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expenses Expense[]

  @@index([deletedAt])
}

// An expense paid from a warehouse (RingzPOS Expenses design: reference,
// date, warehouse, category, title, amount, details). The Expenses module
// builds its CRUD on this; Expense Categories use it to block deleting a
// category that's still in use.
model Expense {
  id                String    @id @default(cuid())
  reference         String    @unique
  date              DateTime
  warehouseId       String
  expenseCategoryId String
  title             String
  amount            Decimal   @db.Decimal(12, 2)
  details           String?   @db.Text
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])

  @@index([deletedAt])
  @@index([warehouseId])
  @@index([expenseCategoryId])
  @@index([date])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  // The seeded walk-in customer the POS uses when no specific customer is
  // selected. See prisma/seed.ts and the guards in
  // app/(dashboard)/customers/actions.ts — this record can't be deleted or
  // renamed, checked server-side via this flag, not just hidden in the UI.
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  sales        Sale[]
  saleReturns  SaleReturn[]
  // Restaurant module.
  orders       Order[]
  reservations Reservation[]

  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Restaurant module (modules/restaurant). New tables only; nothing here is
// read or written while the module is off. Names that must be unique (an
// area within its warehouse, a table across the business) are checked by
// the app among active rows; MySQL has no partial unique indexes, so where
// the database backs one up it's a generated column (NULL when not active)
// with a unique index — Table.activeName, Order.activeTableId, FloorLayout.
// activeAreaId.

// A part of the floor (Main hall, Patio, Bar), stocked from one warehouse.
// Its room (the floor plan editor): metres, the dot grid, the tracing image
// behind it while editing (never shown in service), and the layout's
// version — every save checks and bumps it, so two admins never overwrite
// each other unawares.
model DiningArea {
  id                String    @id @default(cuid())
  name              String
  warehouseId       String
  // Order of the floor plan's area tabs.
  sortOrder         Int       @default(0)
  roomWidthM        Decimal   @default(12) @db.Decimal(6, 2)
  roomHeightM       Decimal   @default(8) @db.Decimal(6, 2)
  gridSizeM         Decimal   @default(0.5) @db.Decimal(4, 2)
  // uploads/floor/<areaId>/… (WebP), Administrator only.
  backgroundImage   String?
  backgroundOpacity Decimal   @default(0.35) @db.Decimal(3, 2)
  // From calibration: image pixels per metre, and where the room's corner
  // sits on the image ({ "x": px, "y": px }).
  backgroundScale   Decimal?  @db.Decimal(10, 4)
  backgroundOffset  Json?
  layoutVersion     Int       @default(0)
  // Locked: the editor won't move or change anything until it's unlocked.
  isLocked          Boolean   @default(false)
  // New table numbers here start with it ("T" → T6).
  prefix            String?   @db.VarChar(4)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  tables       Table[]
  fixtures     FloorFixture[]
  layouts      FloorLayout[]
  // Roles whose Tables screen opens here (Part 6f: the Bartender on the Bar).
  homeForRoles Role[]
  // Staff whose Tables screen opens here (Part 6f).
  homeForStaff User[]         @relation("StaffHomeArea")

  devices Device[] @relation("DeviceHomeArea")

  @@index([deletedAt])
  @@index([warehouseId])
}

// A table's outline on the floor plan.
enum TableShape {
  ROUND
  SQUARE
  RECT
  BOOTH
}

// Things on the floor plan that aren't tables, so staff can find their way.
enum FloorFixtureType {
  BAR_COUNTER
  KITCHEN_PASS
  ENTRANCE
  WALL
  PILLAR
  STAGE
  WINDOW
  LABEL
}

// A fixture on an area's floor plan (metres, like the tables). Fixtures may
// overlap tables.
model FloorFixture {
  id        String           @id @default(cuid())
  areaId    String
  type      FloorFixtureType
  label     String           @db.VarChar(40)
  x         Decimal          @db.Decimal(6, 2)
  y         Decimal          @db.Decimal(6, 2)
  w         Decimal          @db.Decimal(6, 2)
  h         Decimal          @db.Decimal(6, 2)
  // 0, 45 … 315.
  rotation  Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  area DiningArea @relation(fields: [areaId], references: [id])

  @@index([areaId])
  @@index([deletedAt])
}

// A saved layout of an area for an event ("Wedding setup"): every table's
// and fixture's geometry as JSON. At most one is active per area (the
// generated activeAreaId and its unique index); none: the normal layout.
model FloorLayout {
  id           String   @id @default(cuid())
  areaId       String
  name         String   @db.VarChar(60)
  snapshot     Json
  isActive     Boolean  @default(false)
  // GENERATED by MySQL (add_floor_plan migration), never written by the app:
  // areaId while isActive, otherwise NULL — one active layout per area.
  activeAreaId String?  @unique
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // RESTRICT: MySQL allows no CASCADE / SET NULL on a column a stored
  // generated column reads (areaId). Areas are only ever soft-deleted.
  area      DiningArea @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User       @relation("FloorLayoutCreatedBy", fields: [createdById], references: [id])

  @@index([areaId])
  @@index([createdById])
}

// A dining table. Its status (Available / Occupied / Reserved / Cleaning) is
// never stored: modules/restaurant/lib/tableStatus.ts derives it from the
// table's active order, its next reservation and needsCleaning.
model Table {
  id            String     @id @default(cuid())
  name          String
  // GENERATED by MySQL (add_floor_plan migration), never written by the app:
  // name while the table isn't deleted, otherwise NULL. Its unique index
  // keeps table numbers unique across the business among live tables.
  activeName    String?    @unique
  areaId        String
  seats         Int
  // On the area's floor plan, in metres from the room's top-left corner;
  // rotation 0, 45 … 315.
  x             Decimal    @default(0) @db.Decimal(6, 2)
  y             Decimal    @default(0) @db.Decimal(6, 2)
  w             Decimal    @default(1.4) @db.Decimal(6, 2)
  h             Decimal    @default(1.4) @db.Decimal(6, 2)
  rotation      Int        @default(0)
  shape         TableShape @default(SQUARE)
  // The digital menu link, /menu/[qrToken]: random and URL-safe, made on the
  // server. Regenerating it replaces it, so the old link stops working.
  qrToken       String     @unique
  // When its token was last replaced (Rotate token, Part 8); null: never.
  qrRotatedAt   DateTime?
  // Set when its order is billed while cleaning is manual
  // (BusinessSetting.restaurantManualCleaning); cleared by "Mark clean".
  needsCleaning Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  area         DiningArea     @relation(fields: [areaId], references: [id])
  orders       Order[]
  reservations Reservation[]
  requests     TableRequest[]

  @@index([deletedAt])
  @@index([areaId])
}

// A restaurant order: dine-in at a table, or takeaway / delivery (no table).
// Billing creates an ordinary Sale (saleId); revenue is counted only through
// that link.
model Order {
  id                   String             @id @default(cuid())
  // Shown as ORD-0142; MySQL keeps the counter.
  number               Int                @unique @default(autoincrement())
  type                 OrderType          @default(DINE_IN)
  status               OrderStatus        @default(OPEN)
  // Opened by someone in training mode (Part 6f Step 7f): a sandbox order.
  training             Boolean            @default(false)
  tableId              String?
  warehouseId          String
  customerId           String?
  waiterId             String?
  guests               Int                @default(1)
  // A bar tab's name ("Ada — blue shirt"); none for other orders.
  tabName              String?            @db.VarChar(40)
  saleId               String?            @unique
  notes                String?            @db.Text
  openedAt             DateTime           @default(now())
  closedAt             DateTime?
  // The guest's pre-bill ("NOT A RECEIPT") was last printed; cleared by any
  // change to the order after that.
  billPrintedAt        DateTime?
  // Set when a change clears billPrintedAt: the printed bill is out of date
  // ("Bill changed since print"). Cleared by the next print.
  billChangedAt        DateTime?
  // The service charge (BusinessSetting.restaurantServiceChargePercent) is
  // added to this order's bill.
  serviceCharge        Boolean            @default(true)
  // The discount — none while discountType is NULL. One above the limit
  // (BusinessSetting.restaurantDiscountLimitPercent) has an approver.
  discountType         OrderDiscountType?
  discountValue        Decimal            @default(0) @db.Decimal(12, 2)
  discountReason       String?            @db.VarChar(140)
  discountById         String?
  discountApprovedById String?
  // Why it was cancelled ("Merged into ORD-0142", or the reason given).
  cancelReason         String?
  // +1 on every change to the order or its lines. Each change sends the
  // version its screen showed; a different one means someone else changed it.
  version              Int                @default(0)
  // GENERATED by MySQL (see the add_restaurant migration), never written by
  // the app: tableId while the order is OPEN, SENT or SERVED and not deleted,
  // otherwise NULL. Indexed, no longer unique: a shared table can carry
  // several open orders — separate checks (add_table_checks). Who may open
  // one is decided with the table row locked (services/floor.ts).
  activeTableId        String?
  // A separate check at a shared table: its number there (1, 2, 3…) and
  // the guest's name ("Ada"), if given. Dine-in orders only.
  checkNumber          Int?
  checkName            String?            @db.VarChar(40)
  // GUEST: opened by a guest's order from the table's menu (Part 8 Step 7).
  source               OrderSource        @default(STAFF)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  // RESTRICT: MySQL allows no CASCADE / SET NULL on a column a stored
  // generated column reads (tableId). Tables are only ever soft-deleted.
  table              Table?            @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id])
  customer           Customer?         @relation(fields: [customerId], references: [id])
  waiter             User?             @relation("OrderWaiter", fields: [waiterId], references: [id])
  discountBy         User?             @relation("OrderDiscountBy", fields: [discountById], references: [id])
  discountApprovedBy User?             @relation("OrderDiscountApprovedBy", fields: [discountApprovedById], references: [id])
  sale               Sale?             @relation(fields: [saleId], references: [id])
  items              OrderItem[]
  reservation        Reservation?
  kots               Kot[]
  billParts          OrderBillPart[]
  settlements        OrderSettlement[]
  tips               OrderTip[]
  refunds            OrderRefund[]
  guestLines         GuestOrderLine[]

  @@index([deletedAt])
  @@index([status])
  @@index([tableId])
  @@index([activeTableId])
  @@index([warehouseId])
  @@index([customerId])
  @@index([waiterId])
  @@index([discountById])
  @@index([discountApprovedById])
  @@index([openedAt])
  // Restaurant Reports (Step 11)
  @@index([status, closedAt])
  @@index([waiterId, closedAt])
  @@index([training, closedAt])
}

// One line of an order. Price, tax and modifiers are snapshots taken when
// the line is added, so later menu changes never alter it; totals come from
// these through lib/pricing.ts.
model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  // Per unit, including the chosen modifiers' prices.
  unitPrice     Decimal       @db.Decimal(12, 2)
  taxType       TaxType       @default(EXCLUSIVE)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  // The choices made: [{ group, name, price }].
  modifiers     Json?
  // For the kitchen ("no pepper").
  note          String?       @db.Text
  // Superseded by stationId (kept so nothing existing changes).
  station       PrepStation   @default(KITCHEN)
  // The station it was sent to (set by Send to kitchen).
  stationId     String?
  kitchenStatus KitchenStatus @default(NEW)
  // Sent → Preparing → Ready → Served times (the prep-time report).
  sentAt        DateTime?
  startedAt     DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  // Voided after it was sent: kept (struck through) and counted as a
  // cancelled line. A line removed before sending is soft-deleted instead.
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  // What one of this line took from stock when the bill was settled — the
  // dish's ingredients by its recipe then, or the dish itself:
  // [{ productId, productName, quantity }]. A refund that goes back to stock
  // returns that many times this, even if the recipe has changed since.
  stockPerUnit  Json?
  // What one of this line cost when the bill was settled — those stock lines
  // × each product's cost then (Restaurant Reports' food cost). Null: some
  // of them had no cost (or the line wasn't sold). Lines settled before it
  // was recorded were filled in once from the recipes and costs of 12 Nov
  // 2026 (add_order_item_cost).
  unitCost      Decimal?      @db.Decimal(14, 4)
  // A remake (Kitchen Display › Remake): the line it remakes. Made at no
  // charge and never billed, settled, split or refunded — the waste entry
  // for the spoilt one takes its stock, the original line is billed once.
  remakeOfId    String?
  // Touch POS (Part 6e): the guest's seat (1–N), the course, and — while
  // New — held back from Send until it's fired.
  seat          Int?
  course        OrderCourse?
  heldAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  remakeOf       OrderItem?          @relation("OrderItemRemake", fields: [remakeOfId], references: [id])
  remakes        OrderItem[]         @relation("OrderItemRemake")
  product        Product             @relation(fields: [productId], references: [id])
  cancelledBy    User?               @relation("OrderItemCancelledBy", fields: [cancelledById], references: [id])
  kitchenStation KitchenStation?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  kotLines       KotLine[]
  billPartLines  OrderBillPartLine[]
  wasteEntries   WasteEntry[]
  guestLine      GuestOrderLine?

  @@index([orderId])
  @@index([productId])
  @@index([cancelledById])
  @@index([kitchenStatus])
  @@index([stationId, kitchenStatus])
  @@index([remakeOfId])
  @@index([deletedAt])
  // Restaurant Reports (Step 11)
  @@index([orderId, productId])
  @@index([cancelledAt])
}

// A set of choices for menu items (Portion, Extras, Spice level), shared by
// any number of items.
model ModifierGroup {
  id        String    @id @default(cuid())
  name      String
  // How many the guest must / may choose: Portion 1-1 (required), Extras 0-2.
  minSelect Int       @default(0)
  maxSelect Int       @default(1)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  modifiers Modifier[]
  products  Product[]

  @@index([deletedAt])
}

model Modifier {
  id        String    @id @default(cuid())
  groupId   String
  name      String
  // Added to the item's price when chosen (0 for "Regular").
  price     Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group ModifierGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([deletedAt])
}

// One ingredient of a menu item, per serving.
model RecipeLine {
  id           String    @id @default(cuid())
  menuItemId   String
  ingredientId String
  // In the ingredient's own unit (0.25 kg, 1 pc), as in the design.
  quantity     Decimal   @db.Decimal(12, 3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  menuItem   Product @relation("RecipeMenuItem", fields: [menuItemId], references: [id])
  ingredient Product @relation("RecipeIngredient", fields: [ingredientId], references: [id])

  @@index([menuItemId])
  @@index([ingredientId])
  @@index([deletedAt])
}

// A table booking: an existing customer, or a name and phone typed in.
// Seating it opens an Order for the table and links the two (orderId).
model Reservation {
  id          String            @id @default(cuid())
  tableId     String
  customerId  String?
  guestName   String
  guestPhone  String
  partySize   Int
  startsAt    DateTime
  status      ReservationStatus @default(BOOKED)
  notes       String?           @db.Text
  orderId     String?           @unique
  seatedAt    DateTime?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  table     Table     @relation(fields: [tableId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([deletedAt])
  @@index([tableId])
  @@index([customerId])
  @@index([startsAt])
  @@index([status])
}

// One settle: payment taken for the whole bill or one part of a split bill.
// The first settle makes the order's Sale (and moves its stock); later parts
// add their payments to it. idempotencyKey (made when the Payment pop-up
// opened) is unique, so a retry of the same payment answers with this row
// instead of settling again.
model OrderSettlement {
  id             String    @id @default(cuid())
  orderId        String
  // The part paid; NULL: the whole bill.
  partId         String?
  idempotencyKey String    @unique
  saleId         String
  // What was due, the tip on top, and the change handed back.
  amount         Decimal   @db.Decimal(12, 2)
  tip            Decimal   @default(0) @db.Decimal(12, 2)
  change         Decimal   @default(0) @db.Decimal(12, 2)
  // The order's version after this settle, and whether it closed the order
  // — what a retry answers with.
  version        Int
  closedOrder    Boolean
  createdById    String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part      OrderBillPart? @relation(fields: [partId], references: [id])
  sale      Sale           @relation(fields: [saleId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  tips      OrderTip[]

  @@index([orderId])
  @@index([partId])
  @@index([saleId])
  @@index([createdById])
  @@index([deletedAt])
}

// A tip taken with a settle: the waiter's, kept apart from the Sale (not in
// its total), by the method it was paid with.
model OrderTip {
  id           String      @id @default(cuid())
  settlementId String
  orderId      String
  waiterId     String
  paymentType  PaymentType
  amount       Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?

  // The till it was taken on, while open (Part 6f Step 7b): a cash tip is in
  // that drawer until it's paid out.
  tillSessionId String?

  settlement OrderSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiter     User            @relation("OrderTipWaiter", fields: [waiterId], references: [id])
  till       TillSession?    @relation(fields: [tillSessionId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([tillSessionId])
  @@index([orderId])
  @@index([waiterId])
  @@index([deletedAt])
}

// A refund of a settled bill, made from the order: a retail Sale Return
// (with its refund paid) against the order's Sale. returnedToStock: the
// refunded dishes went back into stock — their ingredients as settled
// (OrderItem.stockPerUnit), listed in stockMoves. idempotencyKey (made when
// the Refund pop-up opened) is unique, so a retry can't refund twice.
model OrderRefund {
  id              String    @id @default(cuid())
  orderId         String
  saleReturnId    String    @unique
  idempotencyKey  String    @unique
  returnedToStock Boolean
  stockMoves      Json?
  createdById     String
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@index([orderId])
  @@index([createdById])
  @@index([deletedAt])
}

// Food or stock thrown away (Restaurant › Food › Waste, the kitchen display,
// a returned order line) — not a sale, not a refund: its own stock document,
// like an Adjustment. productId is what was wasted (a menu item or an
// ingredient); its stock lines (WasteEntryLine) say exactly what came out of
// warehouseId — a dish's ingredients by its recipe then, or the item itself —
// with their cost then (costSnapshot is their total; never recalculated).
//
// Immutable: a mistake is corrected by a VOID entry (voidOfId → the entry;
// unique, so it can be voided once) that puts the same lines back, and the
// entry itself is marked VOID.
model WasteEntry {
  id           String      @id @default(cuid())
  // The single business (BusinessSetting "default").
  businessId   String      @default("default")
  warehouseId  String
  productId    String
  qty          Decimal     @db.Decimal(12, 3)
  // The item's unit when it was logged (its own unit: kg, pc, btl…).
  unit         String
  reason       WasteReason
  // Required when the reason is OTHER (checked on input).
  note         String?     @db.VarChar(300)
  costSnapshot Decimal     @db.Decimal(12, 2)
  // Logged from an order line (a Remake, food returned by the guest).
  orderItemId  String?
  loggedById   String
  // Above the approval limit: who approved it with their PIN.
  approvedById String?
  status       WasteStatus @default(ACTIVE)
  voidOfId     String?     @unique
  voidReason   String?     @db.VarChar(300)
  // +1 when it's voided; Void sends the version its screen showed.
  version      Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  business   BusinessSetting  @relation(fields: [businessId], references: [id])
  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id])
  product    Product          @relation(fields: [productId], references: [id])
  orderItem  OrderItem?       @relation(fields: [orderItemId], references: [id])
  loggedBy   User             @relation("WasteLoggedBy", fields: [loggedById], references: [id])
  approvedBy User?            @relation("WasteApprovedBy", fields: [approvedById], references: [id])
  voidOf     WasteEntry?      @relation("WasteVoid", fields: [voidOfId], references: [id])
  voidedBy   WasteEntry?      @relation("WasteVoid")
  lines      WasteEntryLine[]

  @@index([businessId, createdAt])
  @@index([businessId, reason])
  @@index([productId])
  @@index([warehouseId])
  @@index([orderItemId])
  @@index([loggedById])
  @@index([approvedById])
  @@index([deletedAt])
  // Restaurant Reports (Step 11)
  @@index([businessId, status, createdAt])
}

// One stock line of a waste entry: what came out (or, on a VOID entry, went
// back), and its cost when logged.
model WasteEntryLine {
  id        String  @id @default(cuid())
  entryId   String
  productId String
  qty       Decimal @db.Decimal(12, 3)
  unitCost  Decimal @db.Decimal(12, 2)
  lineCost  Decimal @db.Decimal(12, 2)

  entry   WasteEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([entryId])
  @@index([productId])
}

// One part of a split bill. The order's live parts (deletedAt NULL) add up
// exactly to its bill total — any rounding is on the last part. A change to
// the bill's money removes the unpaid parts (split again); once a part is
// PAID the order's bill can't change. No parts: the bill is paid in one.
model OrderBillPart {
  id        String         @id @default(cuid())
  orderId   String
  // 1, 2, 3… within the split.
  number    Int
  mode      BillSplitMode
  amount    Decimal        @db.Decimal(12, 2)
  status    BillPartStatus @default(OPEN)
  paidAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines       OrderBillPartLine[]
  settlements OrderSettlement[]

  @@index([orderId])
  @@index([deletedAt])
}

// By item: how many of an order line's units this part pays for.
model OrderBillPartLine {
  id          String @id @default(cuid())
  partId      String
  orderItemId String
  // How much of the line this guest pays for: `quantity` shares of
  // 1/`shareOf` of a unit — 2 of 1: two whole units; 1 of 2: half a unit (an
  // item shared between two guests); 3 of 2: one and a half.
  quantity    Int
  shareOf     Int    @default(1)

  part      OrderBillPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([partId, orderItemId])
  @@index([orderItemId])
}

// A user's discount-approval PIN (bcrypt hash), set on the restaurant's
// "My approval PIN" screen by someone with Approve Discount. Five wrong
// tries lock it for a few minutes.
model ApprovalPin {
  userId         String    @id
  pinHash        String
  // Set under the Part 6f rules (4 digits, unique, not weak). False: an
  // older PIN (4–6 digits, maybe shared) — it works until it's reset.
  meetsRules     Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// A kitchen station (Kitchen / KIT, Bar / BAR): where menu items are made and
// which tickets its screen shows.
model KitchenStation {
  id           String    @id @default(cuid())
  name         String
  // 2–6 uppercase letters, shown on tickets.
  code         String    @unique
  // A ticket older than this shows as late.
  lateAfterMin Int       @default(15)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  products           Product[]
  orderItems         OrderItem[]
  kots               Kot[]
  // Its KOT printer (Settings › Printers).
  printerAssignments PrinterAssignment[]

  @@index([deletedAt])
}

// A kitchen order ticket (KOT-000123): what one Send to kitchen gave one
// station, or a VOID for a cancelled sent line. Never edited after it's
// created, apart from its print count and bump time.
model Kot {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement())
  type          KotType   @default(NEW)
  orderId       String
  stationId     String
  // Who sent it; null when a guest's order went straight to the kitchen
  // (Part 8 Step 7, autoSendGuestOrders).
  createdById   String?
  // "VOID: <reason>" on a VOID ticket.
  note          String?   @db.Text
  printCount    Int       @default(0)
  lastPrintedAt DateTime?
  // Set once every live line on it is Ready (or Served); cleared on recall.
  bumpedAt      DateTime?
  createdAt     DateTime  @default(now())

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station   KitchenStation @relation(fields: [stationId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id])
  lines     KotLine[]

  @@index([stationId, bumpedAt])
  @@index([orderId])
  @@index([createdById])
  // Restaurant Reports (Step 11)
  @@index([orderId, createdAt])
}

// One line of a KOT, as it was when the ticket was made.
model KotLine {
  id          String  @id @default(cuid())
  kotId       String
  orderItemId String
  name        String
  quantity    Int
  // "Large · no onions".
  modifiers   String? @db.Text
  note        String? @db.Text

  kot       Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([kotId])
  @@index([orderItemId])
}

// ---- Printers (Settings › Printers; the hardware bridge, desktop/bridge) ----

// How the server reaches a printer (desktop/bridge/types.ts):
// OS a print queue (RAW), USB a raw device file (Linux), NETWORK raw TCP
// (host:9100), SERIAL a COM / tty port.
enum PrinterConnection {
  OS
  USB
  NETWORK
  SERIAL
}

enum PrinterCut {
  FULL
  PARTIAL
  NONE
}

// A printer the business prints to. Never deleted while assigned; removed
// ones are soft-deleted and their assignments cleared.
model Printer {
  id         String            @id @default(cuid())
  // The single business (BusinessSetting "default").
  businessId String            @default("default")
  name       String            @db.VarChar(80)
  connection PrinterConnection
  // The OS queue name, "host:port", "COM3" or the device path.
  address    String            @db.VarChar(255)
  // 58 or 80 (mm).
  paperWidth Int               @default(80)
  // ESC/POS code page (lib/hardware/escpos.ts CODE_PAGES), e.g. PC437, WPC1252.
  codePage   String            @default("PC437") @db.VarChar(20)
  cut        PrinterCut        @default(PARTIAL)
  // A cash drawer is plugged into this printer, on pin 2 or 5. It opens on
  // a cash sale or refund at a till that prints receipts here, by hand
  // (Open drawer) and from Settings (lib/hardware/drawer.ts).
  openDrawer Boolean           @default(false)
  drawerPin  Int               @default(2)
  // Serial printers only.
  baudRate   Int               @default(9600)
  model      String?           @db.VarChar(120)
  // What finds it again after a replug or an IP change (Step 7): USB
  // vendor / product / serial, OS queue name, MAC.
  identity   Json?
  // The bridge's last word on it.
  lastStatus String?           @db.VarChar(20)
  lastSeenAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  business     BusinessSetting     @relation(fields: [businessId], references: [id])
  assignments  PrinterAssignment[] @relation("AssignedPrinter")
  fallbackFor  PrinterAssignment[] @relation("FallbackPrinter")
  overrides    DeviceOverride[]
  printJobs    PrintJob[]          @relation("PrintJobPrinter")
  reroutedJobs PrintJob[]          @relation("PrintJobReroutedFrom")
  drawerEvents DrawerEvent[]

  @@index([businessId])
  @@index([deletedAt])
}

// Which printer does a job (role → printer). `role` is the key:
// STATION:<kitchenStationId>, RECEIPT, PREBILL (none: the receipt printer),
// REPORTS. Copies for stations; a fallback used while the main one is
// offline (the ticket says REROUTED FROM <printer>).
model PrinterAssignment {
  id                String   @id @default(cuid())
  businessId        String   @default("default")
  role              String   @db.VarChar(40)
  stationId         String?
  printerId         String
  fallbackPrinterId String?
  copies            Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business BusinessSetting @relation(fields: [businessId], references: [id])
  station  KitchenStation? @relation(fields: [stationId], references: [id], onDelete: Cascade)
  printer  Printer         @relation("AssignedPrinter", fields: [printerId], references: [id])
  fallback Printer?        @relation("FallbackPrinter", fields: [fallbackPrinterId], references: [id])

  @@unique([businessId, role])
  @@index([stationId])
  @@index([printerId])
  @@index([fallbackPrinterId])
}

// A browser that prints (a cashier tablet, the kitchen PC): its id is a
// long-lived cookie, its name the admin's ("Cashier tablet 2").
model Device {
  id                  String               @id
  name                String?              @db.VarChar(80)
  userAgent           String?              @db.VarChar(255)
  lastSeenAt          DateTime             @default(now())
  createdAt           DateTime             @default(now())
  // This device's own restaurant view (Settings › Devices), e.g. a bar PC
  // kept on Classic; null: the business's (BusinessSetting.restaurantInterface).
  restaurantInterface RestaurantInterface?
  // ---- PIN sign-in (Part 6f Step 4). Paired by an Administrator as a
  // restaurant terminal: it always opens on the PIN screen, never the email
  // sign-in. Wrong PINs typed here lock it: 5 in a row → 30 s, then longer
  // each time (pinLockLevel), up to 5 minutes; a right one starts over.
  pinLogin            Boolean              @default(false)
  pairedAt            DateTime?
  pinFailures         Int                  @default(0)
  pinLockedUntil      DateTime?
  pinLockLevel        Int                  @default(0)
  // What a paired device is (Part 6f Step 7c): a PIN terminal (POS), the
  // Kitchen screen (opens the kitchen display; Kitchen staff and managers
  // only) or a Bar terminal (opens Tables on its area, homeAreaId).
  terminalRole        TerminalRole         @default(POS)
  homeAreaId          String?

  overrides DeviceOverride[]
  homeArea  DiningArea?      @relation("DeviceHomeArea", fields: [homeAreaId], references: [id], onDelete: SetNull)

  @@index([lastSeenAt])
}

// This device prints `role` (RECEIPT, PREBILL) on its own printer instead.
model DeviceOverride {
  id        String   @id @default(cuid())
  deviceId  String
  role      String   @db.VarChar(40)
  printerId String
  createdAt DateTime @default(now())

  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  printer Printer @relation(fields: [printerId], references: [id])

  @@unique([deviceId, role])
  @@index([printerId])
}

// ---- The print queue (lib/hardware/printQueue.ts, printWorker.ts) ---------

enum PrintJobType {
  KOT
  KOT_VOID
  RECEIPT
  PREBILL
  REPORT
  TEST
  // Not a ticket: the cash drawer's kick (lib/hardware/drawer.ts) — sent
  // ahead of the tickets, never rerouted, dropped after 30 s.
  DRAWER
}

// QUEUED → PRINTING → DONE; a job that failed 3 times is FAILED (Retry puts
// it back); CANCELLED by hand. A printer that's offline keeps its jobs
// QUEUED (they wait, or move to the role's fallback).
enum PrintJobStatus {
  QUEUED
  PRINTING
  DONE
  FAILED
  CANCELLED
}

// One print: what (a template and its data, rendered for the printer it
// ends up on — so a reprint or a reroute prints the same ticket, marked),
// where, and how it went. Never deleted: the history.
model PrintJob {
  id                    String         @id @default(cuid())
  businessId            String         @default("default")
  printerId             String
  // The role it was sent for (STATION:<id>, RECEIPT, PREBILL); null when
  // sent to a printer directly (a test page).
  role                  String?        @db.VarChar(40)
  type                  PrintJobType
  // What it prints: the Kot, Order or Sale id.
  refId                 String?        @db.VarChar(191)
  // For the queue screen: "KOT-000123 · Kitchen".
  label                 String         @db.VarChar(160)
  // lib/hardware/tickets.ts: KOT, PREBILL, RECEIPT, TEST — and its data,
  // as it was when queued.
  template              String         @db.VarChar(20)
  data                  Json
  copies                Int            @default(1)
  status                PrintJobStatus @default(QUEUED)
  attempts              Int            @default(0)
  error                 String?        @db.VarChar(500)
  // Printed again by hand (marked REPRINT on the ticket).
  reprint               Boolean        @default(false)
  reprintOfId           String?
  // Moved here from that printer while it was offline (REROUTED FROM …).
  reroutedFromPrinterId String?
  // Auto-prints carry one ("KOT:<kotId>"): a ticket is queued once.
  dedupeKey             String?        @unique @db.VarChar(191)
  createdById           String?
  deviceId              String?        @db.VarChar(64)
  // Retry backoff: not tried again before this.
  nextAttemptAt         DateTime       @default(now())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  printedAt             DateTime?

  business     BusinessSetting @relation(fields: [businessId], references: [id])
  printer      Printer         @relation("PrintJobPrinter", fields: [printerId], references: [id])
  reroutedFrom Printer?        @relation("PrintJobReroutedFrom", fields: [reroutedFromPrinterId], references: [id])
  createdBy    User?           @relation(fields: [createdById], references: [id])
  drawerEvent  DrawerEvent?

  @@index([printerId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([type, refId])
  @@index([createdAt])
  @@index([businessId])
  @@index([reroutedFromPrinterId])
  @@index([createdById])
}

// ---- The cash drawer (lib/hardware/drawer.ts) ------------------------------

enum DrawerReason {
  CASH_SALE
  CASH_REFUND
  MANUAL
  TEST
}

// Every time the drawer was told to open: why, who, at which till, on which
// printer, and the sale / refund it was for. Whether it opened is its kick's
// print job (DONE: sent; CANCELLED / FAILED: not opened). Never deleted.
model DrawerEvent {
  id         String       @id @default(cuid())
  businessId String       @default("default")
  reason     DrawerReason
  // Open drawer (by hand): what the cashier typed.
  note       String?      @db.VarChar(140)
  printerId  String
  printJobId String       @unique
  // The Sale or SaleReturn it was for, and its reference (SA_0012).
  refId      String?      @db.VarChar(191)
  refLabel   String?      @db.VarChar(80)
  userId     String?
  deviceId   String?      @db.VarChar(64)
  createdAt  DateTime     @default(now())

  business BusinessSetting @relation(fields: [businessId], references: [id])
  printer  Printer         @relation(fields: [printerId], references: [id])
  printJob PrintJob        @relation(fields: [printJobId], references: [id])
  user     User?           @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([createdAt])
  @@index([reason, createdAt])
  @@index([printerId])
  @@index([userId])
  // Restaurant Reports (Step 11)
  @@index([businessId, createdAt])
  @@index([deviceId, createdAt])
}

// A button group on the touch POS (Part 6e): a tree under each department —
// Food › Rice › Jollof. Tapping a group shows its sub-groups and dishes.
// A sub-group is always in its parent's department.
model MenuGroup {
  id           String         @id @default(cuid())
  name         String
  parentId     String?
  department   MenuDepartment @default(FOOD)
  // "#B4501A"; none: the parent's colour, or the department's shade.
  colour       String?
  // Order in the groups row and the lists.
  rank         Int            @default(0)
  // Its cell in the parent's grid (or the department's home), 0-based
  // across pages of 30; none: the next free cell.
  gridPosition Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  parent   MenuGroup?  @relation("MenuGroupTree", fields: [parentId], references: [id])
  children MenuGroup[] @relation("MenuGroupTree")
  items    Product[]

  @@index([parentId])
  @@index([deletedAt])
}

// Who did what, when (a generic log; Part 7 adds it). The first actions
// logged are the floor plan image's: upload, replace, remove, calibrate.
// action: "floor.background.upload"; entityType/entityId: what it was done
// to ("DiningArea", its id); meta: the details (file size, scale…).
model AuditLog {
  id         String   @id @default(cuid())
  // The single business (BusinessSetting "default").
  businessId String   @default("default")
  // Who did it (none: done by the system).
  userId     String?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(40)
  entityId   String?  @db.VarChar(191)
  meta       Json?
  createdAt  DateTime @default(now())

  business BusinessSetting @relation(fields: [businessId], references: [id])
  user     User?           @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}

// The restaurant's screens (Part 6f; BusinessSetting / Device
// .restaurantInterface).
enum RestaurantInterface {
  SERVICE
  CLASSIC
}

// The six built-in staff roles (Part 6f; Role.systemRole).
enum SystemRole {
  ADMINISTRATOR
  MANAGER
  CASHIER
  WAITER
  BARTENDER
  KITCHEN
}

// Role.accessLevel (Part 6f).
enum AccessLevel {
  SERVICE
  BACK_OFFICE
}

// Role.homeScreen (Part 6f): TABLES — the Tables screen; BAR — Tables on the
// bar's area with the bar tabs; CASHIER — Tables with Pay and Split first;
// KITCHEN — the kitchen display for the role's station.
enum HomeScreen {
  TABLES
  BAR
  CASHIER
  KITCHEN
}

// A shift (Part 6f Step 6, clock in / out — Settings › Staff): started after
// a PIN sign-in ("Start shift?"), ended at LOCK ("End shift?"). A shift
// still open when the person starts another (a later day) is closed then
// (endReason AUTO). Feeds the By-waiter report.
model StaffShift {
  id            String    @id @default(cuid())
  userId        String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  // ENDED (they ended it) or AUTO (closed when the next one started).
  endReason     String?   @db.VarChar(10)
  startDeviceId String?   @db.VarChar(36)
  endDeviceId   String?   @db.VarChar(36)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, endedAt])
  @@index([startedAt])
  // Restaurant Reports (Step 11)
  @@index([userId, startedAt])
}

// A till's session (Part 6f Step 7b, cash-up): a device opened with a float
// by someone with Settle Bill, until it's closed with the cash counted. What
// it took (SalePayment, OrderTip) and paid out (SaleReturnPayment) while open
// points here. At the close the figures are kept as they were: expected
// cash = float + cash taken + cash tips − cash refunds; variance = counted −
// expected. One open session per device.
model TillSession {
  id          String    @id @default(cuid())
  deviceId    String    @db.VarChar(36)
  openedById  String
  openedAt    DateTime  @default(now())
  float       Decimal   @db.Decimal(12, 2)
  closedById  String?
  closedAt    DateTime?
  cashSales   Decimal?  @db.Decimal(12, 2)
  cashTips    Decimal?  @db.Decimal(12, 2)
  cashRefunds Decimal?  @db.Decimal(12, 2)
  expected    Decimal?  @db.Decimal(12, 2)
  counted     Decimal?  @db.Decimal(12, 2)
  variance    Decimal?  @db.Decimal(12, 2)
  note        String?   @db.VarChar(200)
  zPrintedAt  DateTime?

  openedBy User                @relation("TillOpenedBy", fields: [openedById], references: [id])
  closedBy User?               @relation("TillClosedBy", fields: [closedById], references: [id])
  payments SalePayment[]
  refunds  SaleReturnPayment[]
  tips     OrderTip[]

  @@index([deviceId, closedAt])
  @@index([openedAt])
}

// What a paired device is (Part 6f Step 7c).
enum TerminalRole {
  POS
  KITCHEN
  BAR
}

// Each time a menu item is 86'd or comes back (Food › Menu items' Available
// switch), from 12 Nov 2026: Restaurant Reports' "86'd" minutes. available:
// the state it changed to. Items already 86'd then got one row at that time.
// Out of stock isn't recorded here.
model MenuAvailabilityLog {
  id        String   @id @default(cuid())
  productId String
  available Boolean
  // Who switched it (none: before the log, or the system).
  userId    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Digital menu (Part 8)

// What the digital menu shows for an item.
enum MenuMediaType {
  PHOTO
  SPIN
  MODEL
}

// How prices read on the menu: SYMBOL "₦1,500.00", CODE "NGN 1,500.00"
// (the currency is the app's).
enum MenuCurrencyDisplay {
  SYMBOL
  CODE
}

// A QR code that isn't a table: "Takeaway counter", "Bar". Its token is
// made like a table's (lib/qrToken.ts: 144 random bits) and only says which
// point it is.
model QrPoint {
  id          String    @id @default(cuid())
  // The single business (BusinessSetting "default").
  businessId  String    @default("default")
  name        String    @db.VarChar(80)
  qrToken     String    @unique
  // What an order from it is: TAKEAWAY (no table, a name) or BAR_TAB.
  orderType   OrderType
  qrRotatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  business BusinessSetting @relation(fields: [businessId], references: [id])

  @@index([businessId, deletedAt])
}

// A guest's Call waiter / Request bill from the table's menu (Part 8 Step
// 6). OPEN: the bell pulses on the floor screens; ACKNOWLEDGED: a waiter
// tapped it (ackBy, ackAt); DONE: a waiter tapped it again, or it lapsed
// (lib/tableRequests.ts). One open request of each type per table.
model TableRequest {
  id        String             @id @default(cuid())
  tableId   String
  type      TableRequestType
  status    TableRequestStatus @default(OPEN)
  createdAt DateTime           @default(now())
  ackById   String?
  ackAt     DateTime?
  doneAt    DateTime?
  updatedAt DateTime           @updatedAt

  table Table @relation(fields: [tableId], references: [id])
  ackBy User? @relation("TableRequestAck", fields: [ackById], references: [id])

  @@index([tableId, status])
  @@index([status, createdAt])
  @@index([ackById])
}

enum TableRequestType {
  CALL_WAITER
  REQUEST_BILL
}

enum TableRequestStatus {
  OPEN
  ACKNOWLEDGED
  DONE
}

// A line a guest sent from the table's menu (Part 8 Step 7). Priced here on
// the server when it was sent. PENDING: waiting for a waiter to confirm it
// (it isn't on the bill or the kitchen's screen yet); CONFIRMED: it became
// the order line orderItemId; REJECTED: a waiter turned it down. Each keeps
// the code it came through and the guest's phone (a cookie id, address and
// browser) — the abuse log.
model GuestOrderLine {
  id          String          @id @default(cuid())
  orderId     String
  // One Send to waiter: its lines share this.
  sendId      String          @db.VarChar(32)
  productId   String
  quantity    Int
  unitPrice   Decimal         @db.Decimal(12, 2)
  taxType     TaxType         @default(EXCLUSIVE)
  taxRate     Decimal         @default(0) @db.Decimal(5, 2)
  // [{ id, group, name, price }], as on an order line.
  modifiers   Json?
  note        String?         @db.Text
  status      GuestLineStatus @default(PENDING)
  orderItemId String?         @unique
  qrToken     String          @db.VarChar(64)
  deviceId    String          @db.VarChar(64)
  ipAddress   String          @db.VarChar(64)
  userAgent   String          @db.VarChar(255)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  decidedBy User?      @relation("GuestLineDecidedBy", fields: [decidedById], references: [id])

  @@index([orderId, status])
  @@index([qrToken, createdAt])
  @@index([deviceId])
  @@index([status, createdAt])
  @@index([productId])
  @@index([decidedById])
}

enum GuestLineStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum OrderSource {
  STAFF
  GUEST
}

// The digital menu's settings, one row for the business. Guest ordering is
// off until an admin turns it on; with it off the menu is view-only.
model MenuSettings {
  id                    String              @id @default(cuid())
  businessId            String              @unique @default("default")
  menuEnabled           Boolean             @default(true)
  guestOrderingEnabled  Boolean             @default(false)
  autoSendGuestOrders   Boolean             @default(false)
  requireWaiterConfirm  Boolean             @default(true)
  showPrices            Boolean             @default(true)
  // Sold-out items: true, shown greyed; false, hidden.
  showSoldOut           Boolean             @default(true)
  showCalories          Boolean             @default(true)
  showAllergens         Boolean             @default(true)
  // Null: the business's name.
  menuTitle             String?             @db.VarChar(80)
  welcomeText           String?             @db.VarChar(300)
  footerText            String?             @db.VarChar(300)
  logoPath              String?
  accentColour          String              @default("#0f7d6a") @db.VarChar(7)
  currencyDisplay       MenuCurrencyDisplay @default(SYMBOL)
  callWaiterEnabled     Boolean             @default(false)
  requestBillEnabled    Boolean             @default(false)
  // Guest ordering's caps (Step 7): lines per order, and its value (the
  // menu prices; null: no cap). Paused: Add to order is off until resumed
  // (the dashboard's switch), the menu stays up.
  guestOrderMaxLines    Int                 @default(20)
  guestOrderMaxValue    Decimal?            @default(100000) @db.Decimal(12, 2)
  guestOrderingPausedAt DateTime?
  // The address every QR code opens (Step 2): the server on the restaurant's
  // network, e.g. http://192.168.1.20:3000, chosen by an admin. Null: not
  // set yet, so no codes are printed.
  menuBaseUrl           String?             @db.VarChar(200)
  // Printed on the table QR cards only (Step 2), never on the menu.
  wifiName              String?             @db.VarChar(64)
  wifiPassword          String?             @db.VarChar(64)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  business BusinessSetting @relation(fields: [businessId], references: [id])
}
