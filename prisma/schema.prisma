generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// LEGACY — the old fixed role on User.role, kept until the follow-up
// migration (after Role / User.roleId is confirmed). Renamed from `Role` so
// the Role model below can take that name; MySQL stores enums inline, so the
// rename changes no SQL.
enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum TaxType {
  EXCLUSIVE
  INCLUSIVE
}

enum AdjustmentItemType {
  ADDITION
  SUBTRACTION
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Sale returns have their own lifecycle (from the design). Stock comes back
// into the warehouse only while RECEIVED or COMPLETED; PENDING moves none.
enum SaleReturnStatus {
  PENDING
  RECEIVED
  COMPLETED
}

// In-transit rule: a transfer moves stock (From → To) only while COMPLETED.
// PENDING and SENT are paperwork only — nothing leaves From until Completed.
enum TransferStatus {
  PENDING
  SENT
  COMPLETED
}

// Restaurant module. STANDARD: a retail product. MENU_ITEM: sold on orders.
// INGREDIENT: stock used by menu items' recipes.
enum ProductType {
  STANDARD
  MENU_ITEM
  INGREDIENT
}

// Where a menu item is made (the kitchen display's station filter).
enum PrepStation {
  KITCHEN
  BAR
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

// An order's discount: a % of the bill's sub total, or a Naira amount.
enum OrderDiscountType {
  PERCENT
  AMOUNT
}

// How a bill was split: N equal parts, by the items each guest had, or by
// amounts the guests chose.
enum BillSplitMode {
  EQUAL
  ITEMS
  AMOUNT
}

// A bill part: OPEN until it's paid (settled on its own).
enum BillPartStatus {
  OPEN
  PAID
}

// OPEN -> SENT (lines in the kitchen) -> SERVED -> BILLED (its Sale exists).
// CANCELLED: voided before billing. OPEN, SENT and SERVED hold the table:
// one such order per table (Order.activeTableId).
enum OrderStatus {
  OPEN
  SENT
  SERVED
  BILLED
  CANCELLED
}

// One order line's progress. NEW: on the order, not sent yet. PENDING: sent,
// waiting in the kitchen ("Sent" on the order screen, "Pending" on the
// kitchen display). Then PREPARING, READY, SERVED.
enum KitchenStatus {
  NEW
  PENDING
  PREPARING
  READY
  SERVED
}

// A kitchen order ticket: NEW lines sent to a station, or a VOID for a sent
// line that was cancelled.
enum KotType {
  NEW
  VOID
}

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
}

// Why food or stock was thrown away (WasteEntry.reason). OTHER needs a note.
enum WasteReason {
  BURNT
  EXPIRED
  DROPPED
  RETURNED_BY_GUEST
  OVERPRODUCTION
  OTHER
}

// ACTIVE: the waste's stock is out. VOID: an entry that was voided, or the
// VOID entry that reversed it (voidOfId) — the same pattern as KOTs.
enum WasteStatus {
  ACTIVE
  VOID
}

// Business-wide settings: a single row, id "default". Read through
// lib/business-settings.ts, which falls back to these defaults until the row
// is first saved (from the Settings page).
model BusinessSetting {
  id                              String   @id @default("default")
  // The optional Restaurant module (modules/restaurant). Off: its routes
  // 404 and its sidebar group and Role-form permissions are hidden.
  restaurantEnabled               Boolean  @default(false)
  // Restaurant rules. A Booked reservation shows its table as Reserved this
  // many minutes before its time.
  restaurantReservedWindowMinutes Int      @default(60)
  // Bookings on one table must be at least this many minutes apart.
  restaurantBookingGapMinutes     Int      @default(120)
  // true: a billed table shows Cleaning until it's marked clean; false: it's
  // Available as soon as the bill is paid.
  restaurantManualCleaning        Boolean  @default(true)
  // Added to every restaurant bill: this % of the items before tax.
  restaurantServiceChargePercent  Decimal  @default(10) @db.Decimal(5, 2)
  // A discount above this % of the bill's sub total needs a PIN from someone
  // with Approve Discount.
  restaurantDiscountLimitPercent  Decimal  @default(10) @db.Decimal(5, 2)
  // Waste is taken out of this warehouse (an order line's waste: its order's
  // warehouse). Filled by the add_waste migration with the dining areas'.
  restaurantWarehouseId           String?
  // Waste costing more than this (₦) needs a PIN from someone with Approve
  // Waste; 0: no approval needed.
  restaurantWasteApprovalLimit    Decimal  @default(0) @db.Decimal(12, 2)
  // The dashboard's Waste today KPI turns amber / red above these % of
  // today's food cost.
  restaurantWasteAmberPercent     Decimal  @default(5) @db.Decimal(5, 2)
  restaurantWasteRedPercent       Decimal  @default(10) @db.Decimal(5, 2)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  restaurantWarehouse Warehouse?   @relation("RestaurantWarehouse", fields: [restaurantWarehouseId], references: [id])
  wasteEntries        WasteEntry[]
}

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String?
  image       String?
  // LEGACY (see UserRole) — replaced by roleId; dropped in a follow-up
  // migration once every user's mapping is confirmed.
  role        UserRole  @default(CASHIER)
  // Nullable until that follow-up migration makes it required.
  roleId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  userRole           Role?               @relation(fields: [roleId], references: [id])
  adjustments        Adjustment[]
  purchases          Purchase[]
  purchaseReturns    PurchaseReturn[]
  sales              Sale[]
  salePayments       SalePayment[]
  saleReturns        SaleReturn[]
  saleReturnPayments SaleReturnPayment[]
  transfers          Transfer[]
  expenses           Expense[]
  // Restaurant module.
  waitedOrders       Order[]             @relation("OrderWaiter")
  cancelledLines     OrderItem[]         @relation("OrderItemCancelledBy")
  reservations       Reservation[]
  kots               Kot[]
  discountedOrders   Order[]             @relation("OrderDiscountBy")
  approvedDiscounts  Order[]             @relation("OrderDiscountApprovedBy")
  approvalPin        ApprovalPin?
  settlements        OrderSettlement[]
  tips               OrderTip[]          @relation("OrderTipWaiter")
  orderRefunds       OrderRefund[]
  wasteLogged        WasteEntry[]        @relation("WasteLoggedBy")
  wasteApproved      WasteEntry[]        @relation("WasteApprovedBy")

  @@index([deletedAt])
  @@index([roleId])
}

// A named set of permissions (Roles & Permissions). The seeded admin role is
// isSystem: it implicitly has every permission and can't be deleted.
model Role {
  id        String    @id @default(cuid())
  name      String    @unique
  isSystem  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions RolePermission[]
  users       User[]

  @@index([deletedAt])
}

// One granted permission. `permission` is one of the strings in
// lib/permissions.ts (PERMISSIONS) — validated there, stored as text so the
// list can grow without a migration.
model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  zipCode     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  stocks          ProductStock[]
  adjustments     Adjustment[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  sales           Sale[]
  saleReturns     SaleReturn[]
  transfersOut    Transfer[]        @relation("TransferFrom")
  transfersIn     Transfer[]        @relation("TransferTo")
  expenses        Expense[]
  // Restaurant module.
  diningAreas     DiningArea[]
  orders          Order[]
  wasteEntries    WasteEntry[]
  // The restaurant's warehouse (BusinessSetting.restaurantWarehouseId).
  restaurantFor   BusinessSetting[] @relation("RestaurantWarehouse")

  @@index([deletedAt])
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  address     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  stocks          ProductStock[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@index([deletedAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([deletedAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([deletedAt])
}

model Unit {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([deletedAt])
}

model Product {
  id                 String       @id @default(cuid())
  name               String
  code               String       @unique
  price              Decimal      @db.Decimal(12, 2)
  // Default net unit cost for purchase lines; not yet on the Product form.
  cost               Decimal?     @db.Decimal(12, 2)
  categoryId         String
  brandId            String
  unitId             String
  stockAlert         Int?
  orderTax           Decimal?     @db.Decimal(5, 2)
  taxType            TaxType
  quantityLimitation Int?
  notes              String?      @db.Text
  // Array of uploaded image paths; the first entry is the list thumbnail.
  // MySQL has no native array column, so this is stored as JSON.
  images             Json?
  // Restaurant module. Every existing product is STANDARD (retail); the
  // other columns only mean something for MENU_ITEM.
  productType        ProductType  @default(STANDARD)
  // Listed on the digital menu.
  showOnMenu         Boolean      @default(false)
  // Can be ordered right now (off: "Unavailable" on the menu and order screen).
  isAvailable        Boolean      @default(true)
  // Superseded by stationId (kept so nothing existing changes).
  prepStation        PrepStation?
  // Where it's made (the kitchen display's station). None: the first active
  // station.
  stationId          String?
  menuDescription    String?      @db.Text
  menuImage          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  category            Category             @relation(fields: [categoryId], references: [id])
  brand               Brand                @relation(fields: [brandId], references: [id])
  unit                Unit                 @relation(fields: [unitId], references: [id])
  stocks              ProductStock[]
  adjustmentItems     AdjustmentItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  transferItems       TransferItem[]
  // Restaurant module.
  orderItems          OrderItem[]
  modifierGroups      ModifierGroup[]
  recipeLines         RecipeLine[]         @relation("RecipeMenuItem")
  usedInRecipes       RecipeLine[]         @relation("RecipeIngredient")
  wasteEntries        WasteEntry[]
  wasteLines          WasteEntryLine[]
  kitchenStation      KitchenStation?      @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([productType])
  @@index([stationId])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
}

// The current stock balance for one product in one warehouse — exactly one
// row per (productId, warehouseId) pair, never a movement ledger. Every
// change (initial stock on product create, Adjustments, eventually
// Purchases/Sales/Transfers) goes through lib/stock.ts's increase/decrease
// helpers, which upsert this row inside a transaction. "In stock" for a
// product is the sum of its rows across warehouses (groupBy/_sum), and the
// per-warehouse breakdown is just these rows directly.
model ProductStock {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  supplierId  String?
  quantity    Int
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@index([supplierId])
}

model Adjustment {
  id          String    @id @default(cuid())
  reference   String    @unique
  warehouseId String
  date        DateTime
  notes       String?   @db.Text
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     AdjustmentItem[]

  @@index([deletedAt])
  @@index([warehouseId])
}

model AdjustmentItem {
  id           String             @id @default(cuid())
  adjustmentId String
  productId    String
  quantity     Int
  type         AdjustmentItemType

  adjustment Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
}

model Purchase {
  id             String         @id @default(cuid())
  reference      String         @unique
  supplierId     String
  warehouseId    String
  date           DateTime
  status         PurchaseStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  shipping       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  paymentType    PaymentType    @default(CASH)
  paymentStatus  PaymentStatus  @default(UNPAID)
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]
  returns   PurchaseReturn[]

  @@index([deletedAt])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([date])
}

model PurchaseItem {
  id           String       @id @default(cuid())
  purchaseId   String
  productId    String
  quantity     Int
  purchaseUnit String
  // Unit cost as entered; subtotal and amounts are recomputed server-side
  // through lib/pricing.ts and stored for display/reporting.
  netUnitCost  Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// A return of purchased goods to the supplier — the outbound mirror of
// Purchase. While RECEIVED it takes stock OUT of its warehouse (a Purchase
// puts stock in); see lib/purchase-stock.ts for the reconciliation.
model PurchaseReturn {
  id             String         @id @default(cuid())
  reference      String         @unique
  supplierId     String
  warehouseId    String
  // Optional link to the purchase being returned against.
  purchaseId     String?
  date           DateTime
  status         PurchaseStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  shipping       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  paid           Decimal        @default(0) @db.Decimal(12, 2)
  due            Decimal        @db.Decimal(12, 2)
  paymentType    PaymentType    @default(CASH)
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  purchase  Purchase?            @relation(fields: [purchaseId], references: [id])
  createdBy User                 @relation(fields: [createdById], references: [id])
  items     PurchaseReturnItem[]

  @@index([deletedAt])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([purchaseId])
  @@index([date])
}

model PurchaseReturnItem {
  id           String       @id @default(cuid())
  returnId     String
  productId    String
  quantity     Int
  purchaseUnit String
  // Unit cost as entered; subtotal and amounts are recomputed server-side
  // through lib/pricing.ts, exactly as for PurchaseItem.
  netUnitCost  Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  // Named purchaseReturn (not "return") to keep the client field readable.
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

// A sale to a customer. While RECEIVED it takes stock OUT of its warehouse
// (same status rule and reconciliation as Purchases, direction "out").
//
// paid / due / paymentStatus / paymentType are derived from the sale's
// active SalePayment rows vs grandTotal (computePaymentState) and stored only
// so the list can show and sum them — they are never typed in directly.
model Sale {
  id             String         @id @default(cuid())
  reference      String         @unique
  customerId     String
  warehouseId    String
  date           DateTime
  status         PurchaseStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  shipping       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  paid           Decimal        @default(0) @db.Decimal(12, 2)
  due            Decimal        @db.Decimal(12, 2)
  paymentStatus  PaymentStatus  @default(UNPAID)
  // Type of the latest active payment (list column); null until paid.
  paymentType    PaymentType?
  notes          String?        @db.Text
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  customer              Customer          @relation(fields: [customerId], references: [id])
  warehouse             Warehouse         @relation(fields: [warehouseId], references: [id])
  createdBy             User              @relation(fields: [createdById], references: [id])
  items                 SaleItem[]
  payments              SalePayment[]
  returns               SaleReturn[]
  // Restaurant module: the order this sale billed, if any, and each time
  // part of its bill was paid.
  order                 Order?
  restaurantSettlements OrderSettlement[]

  @@index([deletedAt])
  @@index([customerId])
  @@index([warehouseId])
  @@index([date])
}

model SaleItem {
  id           String       @id @default(cuid())
  saleId       String
  productId    String
  quantity     Int
  saleUnit     String
  // Unit price as entered (defaults to Product.price); subtotal and amounts
  // are recomputed server-side through lib/pricing.ts.
  netUnitPrice Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnLines SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

// One payment against a sale; a sale can have several. Soft-deleted rows
// don't count towards paid.
model SalePayment {
  id          String      @id @default(cuid())
  saleId      String
  amount      Decimal     @db.Decimal(12, 2)
  paymentType PaymentType
  date        DateTime
  notes       String?     @db.Text
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([saleId])
  @@index([deletedAt])
}

// A customer returning goods from a sale. Always created from a sale: the
// customer and warehouse are copied from it and never chosen on the form.
// While RECEIVED or COMPLETED it puts stock back INTO the warehouse (the
// reverse of a sale).
//
// paid / due / paymentStatus describe the REFUND owed to the customer —
// derived from the active SaleReturnPayment rows vs grandTotal with
// computePaymentState, never typed in.
model SaleReturn {
  id             String           @id @default(cuid())
  reference      String           @unique
  // Required for every new return; nullable at the DB level per spec.
  saleId         String?
  customerId     String
  warehouseId    String
  date           DateTime
  status         SaleReturnStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax       Decimal          @default(0) @db.Decimal(5, 2)
  orderTaxAmount Decimal          @default(0) @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  shipping       Decimal          @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal          @db.Decimal(12, 2)
  paid           Decimal          @default(0) @db.Decimal(12, 2)
  due            Decimal          @db.Decimal(12, 2)
  paymentStatus  PaymentStatus    @default(UNPAID)
  notes          String?          @db.Text
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  sale             Sale?               @relation(fields: [saleId], references: [id])
  customer         Customer            @relation(fields: [customerId], references: [id])
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy        User                @relation(fields: [createdById], references: [id])
  items            SaleReturnItem[]
  payments         SaleReturnPayment[]
  // Restaurant module: the refund of a settled bill this return records.
  restaurantRefund OrderRefund?

  @@index([deletedAt])
  @@index([saleId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([date])
}

model SaleReturnItem {
  id           String       @id @default(cuid())
  returnId     String
  productId    String
  // The original sale line being returned. RESTRICT: a sale line with return
  // history is never deleted (Sales edit updates lines in place).
  saleItemId   String
  quantity     Int
  saleUnit     String
  // Unit price as on the sale line (or edited in the line modal); amounts are
  // recomputed server-side through lib/pricing.ts.
  netUnitPrice Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([saleItemId])
}

// One refund paid to the customer against a sale return (same pattern as
// SalePayment). Soft-deleted rows don't count towards paid.
model SaleReturnPayment {
  id           String      @id @default(cuid())
  saleReturnId String
  amount       Decimal     @db.Decimal(12, 2)
  paymentType  PaymentType
  date         DateTime
  notes        String?     @db.Text
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@index([saleReturnId])
  @@index([deletedAt])
}

// Moves stock between two warehouses. No supplier, customer or payment.
// Money columns mirror the other documents (valued at cost).
model Transfer {
  id              String         @id @default(cuid())
  reference       String         @unique
  fromWarehouseId String
  toWarehouseId   String
  date            DateTime
  status          TransferStatus
  // Order-level money. orderTax is a percentage; the rest are Naira amounts.
  orderTax        Decimal        @default(0) @db.Decimal(5, 2)
  orderTaxAmount  Decimal        @default(0) @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  shipping        Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal        @db.Decimal(12, 2)
  notes           String?        @db.Text
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  fromWarehouse Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  items         TransferItem[]

  @@index([deletedAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([date])
}

model TransferItem {
  id           String       @id @default(cuid())
  transferId   String
  productId    String
  quantity     Int
  transferUnit String
  // Unit cost as entered (defaults to Product.cost); subtotal and amounts
  // are recomputed server-side through lib/pricing.ts.
  netUnitCost  Decimal      @db.Decimal(12, 2)
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal     Decimal      @db.Decimal(12, 2)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

// Name-only lookup for expenses (managed like Product Categories / Brands,
// but without a logo).
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expenses Expense[]

  @@index([deletedAt])
}

// An expense paid from a warehouse (RingzPOS Expenses design: reference,
// date, warehouse, category, title, amount, details). The Expenses module
// builds its CRUD on this; Expense Categories use it to block deleting a
// category that's still in use.
model Expense {
  id                String    @id @default(cuid())
  reference         String    @unique
  date              DateTime
  warehouseId       String
  expenseCategoryId String
  title             String
  amount            Decimal   @db.Decimal(12, 2)
  details           String?   @db.Text
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])

  @@index([deletedAt])
  @@index([warehouseId])
  @@index([expenseCategoryId])
  @@index([date])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  // The seeded walk-in customer the POS uses when no specific customer is
  // selected. See prisma/seed.ts and the guards in
  // app/(dashboard)/customers/actions.ts — this record can't be deleted or
  // renamed, checked server-side via this flag, not just hidden in the UI.
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  sales        Sale[]
  saleReturns  SaleReturn[]
  // Restaurant module.
  orders       Order[]
  reservations Reservation[]

  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Restaurant module (modules/restaurant). New tables only; nothing here is
// read or written while the module is off. Names that must be unique (an
// area within its warehouse, a table within its area) are checked by the
// app among active rows: MySQL has no partial unique indexes.

// A part of the floor (Main hall, Patio, Bar), stocked from one warehouse.
model DiningArea {
  id          String    @id @default(cuid())
  name        String
  warehouseId String
  // Order of the floor plan's area tabs.
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  tables    Table[]

  @@index([deletedAt])
  @@index([warehouseId])
}

// A dining table. Its status (Available / Occupied / Reserved / Cleaning) is
// never stored: modules/restaurant/lib/tableStatus.ts derives it from the
// table's active order, its next reservation and needsCleaning.
model Table {
  id            String    @id @default(cuid())
  name          String
  areaId        String
  seats         Int
  // The digital menu link, /menu/[qrToken]: random and URL-safe, made on the
  // server. Regenerating it replaces it, so the old link stops working.
  qrToken       String    @unique
  // Set when its order is billed while cleaning is manual
  // (BusinessSetting.restaurantManualCleaning); cleared by "Mark clean".
  needsCleaning Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  area         DiningArea    @relation(fields: [areaId], references: [id])
  orders       Order[]
  reservations Reservation[]

  @@index([deletedAt])
  @@index([areaId])
}

// A restaurant order: dine-in at a table, or takeaway / delivery (no table).
// Billing creates an ordinary Sale (saleId); revenue is counted only through
// that link.
model Order {
  id                   String             @id @default(cuid())
  // Shown as ORD-0142; MySQL keeps the counter.
  number               Int                @unique @default(autoincrement())
  type                 OrderType          @default(DINE_IN)
  status               OrderStatus        @default(OPEN)
  tableId              String?
  warehouseId          String
  customerId           String?
  waiterId             String?
  guests               Int                @default(1)
  saleId               String?            @unique
  notes                String?            @db.Text
  openedAt             DateTime           @default(now())
  closedAt             DateTime?
  // The guest's pre-bill ("NOT A RECEIPT") was last printed; cleared by any
  // change to the order after that.
  billPrintedAt        DateTime?
  // Set when a change clears billPrintedAt: the printed bill is out of date
  // ("Bill changed since print"). Cleared by the next print.
  billChangedAt        DateTime?
  // The service charge (BusinessSetting.restaurantServiceChargePercent) is
  // added to this order's bill.
  serviceCharge        Boolean            @default(true)
  // The discount — none while discountType is NULL. One above the limit
  // (BusinessSetting.restaurantDiscountLimitPercent) has an approver.
  discountType         OrderDiscountType?
  discountValue        Decimal            @default(0) @db.Decimal(12, 2)
  discountReason       String?            @db.VarChar(140)
  discountById         String?
  discountApprovedById String?
  // Why it was cancelled ("Merged into ORD-0142", or the reason given).
  cancelReason         String?
  // +1 on every change to the order or its lines. Each change sends the
  // version its screen showed; a different one means someone else changed it.
  version              Int                @default(0)
  // GENERATED by MySQL (see the add_restaurant migration), never written by
  // the app: tableId while the order is OPEN, SENT or SERVED and not deleted,
  // otherwise NULL. Its unique index is the "one active order per table"
  // rule; NULLs don't collide.
  activeTableId        String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  // RESTRICT: MySQL allows no CASCADE / SET NULL on a column a stored
  // generated column reads (tableId). Tables are only ever soft-deleted.
  table              Table?            @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id])
  customer           Customer?         @relation(fields: [customerId], references: [id])
  waiter             User?             @relation("OrderWaiter", fields: [waiterId], references: [id])
  discountBy         User?             @relation("OrderDiscountBy", fields: [discountById], references: [id])
  discountApprovedBy User?             @relation("OrderDiscountApprovedBy", fields: [discountApprovedById], references: [id])
  sale               Sale?             @relation(fields: [saleId], references: [id])
  items              OrderItem[]
  reservation        Reservation?
  kots               Kot[]
  billParts          OrderBillPart[]
  settlements        OrderSettlement[]
  tips               OrderTip[]
  refunds            OrderRefund[]

  @@index([deletedAt])
  @@index([status])
  @@index([tableId])
  @@index([warehouseId])
  @@index([customerId])
  @@index([waiterId])
  @@index([discountById])
  @@index([discountApprovedById])
  @@index([openedAt])
}

// One line of an order. Price, tax and modifiers are snapshots taken when
// the line is added, so later menu changes never alter it; totals come from
// these through lib/pricing.ts.
model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  // Per unit, including the chosen modifiers' prices.
  unitPrice     Decimal       @db.Decimal(12, 2)
  taxType       TaxType       @default(EXCLUSIVE)
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  // The choices made: [{ group, name, price }].
  modifiers     Json?
  // For the kitchen ("no pepper").
  note          String?       @db.Text
  // Superseded by stationId (kept so nothing existing changes).
  station       PrepStation   @default(KITCHEN)
  // The station it was sent to (set by Send to kitchen).
  stationId     String?
  kitchenStatus KitchenStatus @default(NEW)
  // Sent → Preparing → Ready → Served times (the prep-time report).
  sentAt        DateTime?
  startedAt     DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  // Voided after it was sent: kept (struck through) and counted as a
  // cancelled line. A line removed before sending is soft-deleted instead.
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  // What one of this line took from stock when the bill was settled — the
  // dish's ingredients by its recipe then, or the dish itself:
  // [{ productId, productName, quantity }]. A refund that goes back to stock
  // returns that many times this, even if the recipe has changed since.
  stockPerUnit  Json?
  // A remake (Kitchen Display › Remake): the line it remakes. Made at no
  // charge and never billed, settled, split or refunded — the waste entry
  // for the spoilt one takes its stock, the original line is billed once.
  remakeOfId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  remakeOf       OrderItem?          @relation("OrderItemRemake", fields: [remakeOfId], references: [id])
  remakes        OrderItem[]         @relation("OrderItemRemake")
  product        Product             @relation(fields: [productId], references: [id])
  cancelledBy    User?               @relation("OrderItemCancelledBy", fields: [cancelledById], references: [id])
  kitchenStation KitchenStation?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  kotLines       KotLine[]
  billPartLines  OrderBillPartLine[]
  wasteEntries   WasteEntry[]

  @@index([orderId])
  @@index([productId])
  @@index([cancelledById])
  @@index([kitchenStatus])
  @@index([stationId, kitchenStatus])
  @@index([remakeOfId])
  @@index([deletedAt])
}

// A set of choices for menu items (Portion, Extras, Spice level), shared by
// any number of items.
model ModifierGroup {
  id        String    @id @default(cuid())
  name      String
  // How many the guest must / may choose: Portion 1-1 (required), Extras 0-2.
  minSelect Int       @default(0)
  maxSelect Int       @default(1)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  modifiers Modifier[]
  products  Product[]

  @@index([deletedAt])
}

model Modifier {
  id        String    @id @default(cuid())
  groupId   String
  name      String
  // Added to the item's price when chosen (0 for "Regular").
  price     Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group ModifierGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([deletedAt])
}

// One ingredient of a menu item, per serving.
model RecipeLine {
  id           String    @id @default(cuid())
  menuItemId   String
  ingredientId String
  // In the ingredient's own unit (0.25 kg, 1 pc), as in the design.
  quantity     Decimal   @db.Decimal(12, 3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  menuItem   Product @relation("RecipeMenuItem", fields: [menuItemId], references: [id])
  ingredient Product @relation("RecipeIngredient", fields: [ingredientId], references: [id])

  @@index([menuItemId])
  @@index([ingredientId])
  @@index([deletedAt])
}

// A table booking: an existing customer, or a name and phone typed in.
// Seating it opens an Order for the table and links the two (orderId).
model Reservation {
  id          String            @id @default(cuid())
  tableId     String
  customerId  String?
  guestName   String
  guestPhone  String
  partySize   Int
  startsAt    DateTime
  status      ReservationStatus @default(BOOKED)
  notes       String?           @db.Text
  orderId     String?           @unique
  seatedAt    DateTime?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  table     Table     @relation(fields: [tableId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([deletedAt])
  @@index([tableId])
  @@index([customerId])
  @@index([startsAt])
  @@index([status])
}

// One settle: payment taken for the whole bill or one part of a split bill.
// The first settle makes the order's Sale (and moves its stock); later parts
// add their payments to it. idempotencyKey (made when the Payment pop-up
// opened) is unique, so a retry of the same payment answers with this row
// instead of settling again.
model OrderSettlement {
  id             String    @id @default(cuid())
  orderId        String
  // The part paid; NULL: the whole bill.
  partId         String?
  idempotencyKey String    @unique
  saleId         String
  // What was due, the tip on top, and the change handed back.
  amount         Decimal   @db.Decimal(12, 2)
  tip            Decimal   @default(0) @db.Decimal(12, 2)
  change         Decimal   @default(0) @db.Decimal(12, 2)
  // The order's version after this settle, and whether it closed the order
  // — what a retry answers with.
  version        Int
  closedOrder    Boolean
  createdById    String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part      OrderBillPart? @relation(fields: [partId], references: [id])
  sale      Sale           @relation(fields: [saleId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  tips      OrderTip[]

  @@index([orderId])
  @@index([partId])
  @@index([saleId])
  @@index([createdById])
  @@index([deletedAt])
}

// A tip taken with a settle: the waiter's, kept apart from the Sale (not in
// its total), by the method it was paid with.
model OrderTip {
  id           String      @id @default(cuid())
  settlementId String
  orderId      String
  waiterId     String
  paymentType  PaymentType
  amount       Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?

  settlement OrderSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiter     User            @relation("OrderTipWaiter", fields: [waiterId], references: [id])

  @@index([settlementId])
  @@index([orderId])
  @@index([waiterId])
  @@index([deletedAt])
}

// A refund of a settled bill, made from the order: a retail Sale Return
// (with its refund paid) against the order's Sale. returnedToStock: the
// refunded dishes went back into stock — their ingredients as settled
// (OrderItem.stockPerUnit), listed in stockMoves. idempotencyKey (made when
// the Refund pop-up opened) is unique, so a retry can't refund twice.
model OrderRefund {
  id              String    @id @default(cuid())
  orderId         String
  saleReturnId    String    @unique
  idempotencyKey  String    @unique
  returnedToStock Boolean
  stockMoves      Json?
  createdById     String
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@index([orderId])
  @@index([createdById])
  @@index([deletedAt])
}

// Food or stock thrown away (Restaurant › Food › Waste, the kitchen display,
// a returned order line) — not a sale, not a refund: its own stock document,
// like an Adjustment. productId is what was wasted (a menu item or an
// ingredient); its stock lines (WasteEntryLine) say exactly what came out of
// warehouseId — a dish's ingredients by its recipe then, or the item itself —
// with their cost then (costSnapshot is their total; never recalculated).
//
// Immutable: a mistake is corrected by a VOID entry (voidOfId → the entry;
// unique, so it can be voided once) that puts the same lines back, and the
// entry itself is marked VOID.
model WasteEntry {
  id           String      @id @default(cuid())
  // The single business (BusinessSetting "default").
  businessId   String      @default("default")
  warehouseId  String
  productId    String
  qty          Decimal     @db.Decimal(12, 3)
  // The item's unit when it was logged (its own unit: kg, pc, btl…).
  unit         String
  reason       WasteReason
  // Required when the reason is OTHER (checked on input).
  note         String?     @db.VarChar(300)
  costSnapshot Decimal     @db.Decimal(12, 2)
  // Logged from an order line (a Remake, food returned by the guest).
  orderItemId  String?
  loggedById   String
  // Above the approval limit: who approved it with their PIN.
  approvedById String?
  status       WasteStatus @default(ACTIVE)
  voidOfId     String?     @unique
  voidReason   String?     @db.VarChar(300)
  // +1 when it's voided; Void sends the version its screen showed.
  version      Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  business   BusinessSetting  @relation(fields: [businessId], references: [id])
  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id])
  product    Product          @relation(fields: [productId], references: [id])
  orderItem  OrderItem?       @relation(fields: [orderItemId], references: [id])
  loggedBy   User             @relation("WasteLoggedBy", fields: [loggedById], references: [id])
  approvedBy User?            @relation("WasteApprovedBy", fields: [approvedById], references: [id])
  voidOf     WasteEntry?      @relation("WasteVoid", fields: [voidOfId], references: [id])
  voidedBy   WasteEntry?      @relation("WasteVoid")
  lines      WasteEntryLine[]

  @@index([businessId, createdAt])
  @@index([businessId, reason])
  @@index([productId])
  @@index([warehouseId])
  @@index([orderItemId])
  @@index([loggedById])
  @@index([approvedById])
  @@index([deletedAt])
}

// One stock line of a waste entry: what came out (or, on a VOID entry, went
// back), and its cost when logged.
model WasteEntryLine {
  id        String  @id @default(cuid())
  entryId   String
  productId String
  qty       Decimal @db.Decimal(12, 3)
  unitCost  Decimal @db.Decimal(12, 2)
  lineCost  Decimal @db.Decimal(12, 2)

  entry   WasteEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([entryId])
  @@index([productId])
}

// One part of a split bill. The order's live parts (deletedAt NULL) add up
// exactly to its bill total — any rounding is on the last part. A change to
// the bill's money removes the unpaid parts (split again); once a part is
// PAID the order's bill can't change. No parts: the bill is paid in one.
model OrderBillPart {
  id        String         @id @default(cuid())
  orderId   String
  // 1, 2, 3… within the split.
  number    Int
  mode      BillSplitMode
  amount    Decimal        @db.Decimal(12, 2)
  status    BillPartStatus @default(OPEN)
  paidAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines       OrderBillPartLine[]
  settlements OrderSettlement[]

  @@index([orderId])
  @@index([deletedAt])
}

// By item: how many of an order line's units this part pays for.
model OrderBillPartLine {
  id          String @id @default(cuid())
  partId      String
  orderItemId String
  quantity    Int

  part      OrderBillPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([partId, orderItemId])
  @@index([orderItemId])
}

// A user's discount-approval PIN (bcrypt hash), set on the restaurant's
// "My approval PIN" screen by someone with Approve Discount. Five wrong
// tries lock it for a few minutes.
model ApprovalPin {
  userId         String    @id
  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// A kitchen station (Kitchen / KIT, Bar / BAR): where menu items are made and
// which tickets its screen shows.
model KitchenStation {
  id           String    @id @default(cuid())
  name         String
  // 2–6 uppercase letters, shown on tickets.
  code         String    @unique
  // A ticket older than this shows as late.
  lateAfterMin Int       @default(15)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  products   Product[]
  orderItems OrderItem[]
  kots       Kot[]

  @@index([deletedAt])
}

// A kitchen order ticket (KOT-000123): what one Send to kitchen gave one
// station, or a VOID for a cancelled sent line. Never edited after it's
// created, apart from its print count and bump time.
model Kot {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement())
  type          KotType   @default(NEW)
  orderId       String
  stationId     String
  createdById   String
  // "VOID: <reason>" on a VOID ticket.
  note          String?   @db.Text
  printCount    Int       @default(0)
  lastPrintedAt DateTime?
  // Set once every live line on it is Ready (or Served); cleared on recall.
  bumpedAt      DateTime?
  createdAt     DateTime  @default(now())

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station   KitchenStation @relation(fields: [stationId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  lines     KotLine[]

  @@index([stationId, bumpedAt])
  @@index([orderId])
  @@index([createdById])
}

// One line of a KOT, as it was when the ticket was made.
model KotLine {
  id          String  @id @default(cuid())
  kotId       String
  orderItemId String
  name        String
  quantity    Int
  // "Large · no onions".
  modifiers   String? @db.Text
  note        String? @db.Text

  kot       Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([kotId])
  @@index([orderItemId])
}
